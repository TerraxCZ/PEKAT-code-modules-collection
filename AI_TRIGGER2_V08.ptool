{"type":"CODE","module":{"label":"AI_TRIGGER2_V08","id":9,"note":"Umožňuje propustit N snímků k propuštění na základě DEBOUNCE M snímků a tento nasycený stav poté resetovat definovaným stavem.\n\nAKA: Pokud chcu uložit jen jeden OK snímek a ne 38 tak tam hodím toto a když to uvidí např. podlahu, tak se to zas resetuje... ","gpuSettings":[],"softDeletedDate":null,"type":"CODE","sourceCode":"\"\"\"\r\nAI_TRIGGER2_V07\r\nModul pro řízení toku snímků (Trigger/Filter) s plnou podporou formulářových prvků.\r\n\r\nUmožňuje propustit N snímků na základě DEBOUNCE M snímků a tento nasycený stav \r\npoté resetovat definovaným stavem.\r\n\"\"\"\r\n\r\nimport __main__\r\n\r\n# =========================\r\n# KONFIGURACE – DEFAULTY\r\n# =========================\r\nMODE_DEFAULT = \"on_result\"\r\nSOURCE_SELECT_DEFAULT = \"ANY\"\r\nALLOWED_CLASSES_DEFAULT = [\"POZICE\"]\r\nRESET_CLASSES_DEFAULT = [\"OUT\"]\r\nRESET_HAS_PRIORITY_DEFAULT = True\r\nDETECTOR_BOTH_POLICY_DEFAULT = \"reset\"\r\nRESULT_OK_IS_ALLOWED_DEFAULT = True\r\nLOOP_NUMBER_DEFAULT = 1\r\nFRAME_NUMBER_DEFAULT = 1\r\nVERBOSE_DEFAULT = True\r\n\r\n# =========================\r\n# Pomocné utilitky\r\n# =========================\r\ndef _parse_bool(val, default=False):\r\n    if isinstance(val, bool):\r\n        return val\r\n    if isinstance(val, (int, float)):\r\n        return bool(val)\r\n    if isinstance(val, str):\r\n        v = val.strip().lower()\r\n        if v in (\"1\", \"true\", \"t\", \"yes\", \"y\", \"on\"):\r\n            return True\r\n        if v in (\"0\", \"false\", \"f\", \"no\", \"n\", \"off\", \"\"):\r\n            return False\r\n    return default\r\n\r\ndef _parse_csv_to_list(s, default_list):\r\n    if isinstance(s, str):\r\n        items = [x.strip() for x in s.split(\",\") if x.strip()]\r\n        return items\r\n    if isinstance(s, (list, tuple)):\r\n        return [str(x).strip() for x in s if str(x).strip()]\r\n    return list(default_list)\r\n\r\ndef _norm_src_type(raw) -> str:\r\n    \"\"\"Normalizace typu zdroje na 'CLASSIFIER' / 'DETECTOR' / jinak uppercased.\"\"\"\r\n    if raw is None:\r\n        return \"\"\r\n    t = str(raw).strip().upper()\r\n    if \"CLASSIF\" in t:\r\n        return \"CLASSIFIER\"\r\n    if \"DETECT\" in t:\r\n        return \"DETECTOR\"\r\n    return t\r\n\r\ndef _get_top_label_from_classifier(rect) -> str:\r\n    \"\"\"Z klasifikátoru bere výhradně TOP-1 třídu.\"\"\"\r\n    class_names = rect.get(\"classNames\", [])\r\n    if not isinstance(class_names, list) or not class_names:\r\n        return \"\"\r\n    first = class_names[0]\r\n    if isinstance(first, dict):\r\n        return str(first.get(\"label\", \"\")).strip()\r\n    return str(first).strip()\r\n\r\ndef _get_all_labels_from_detector(rect) -> list:\r\n    \"\"\"Z detektoru bere množinu všech detekovaných tříd.\"\"\"\r\n    out = []\r\n    class_names = rect.get(\"classNames\", [])\r\n    if isinstance(class_names, list):\r\n        for item in class_names:\r\n            if isinstance(item, dict):\r\n                lab = str(item.get(\"label\", \"\")).strip()\r\n            else:\r\n                lab = str(item).strip()\r\n            if lab:\r\n                out.append(lab)\r\n    return out\r\n\r\n# =========================\r\n# Načtení parametrů z formuláře PEKAT Vision\r\n# =========================\r\ndef _get_params(context, form):\r\n    form_dict = form if isinstance(form, dict) else {}\r\n\r\n    P = {\r\n        \"MODE\": str(form_dict.get(\"MODE_DEFAULT_form\", MODE_DEFAULT)).strip(),\r\n        \"SOURCE_SELECT\": str(form_dict.get(\"SOURCE_SELECT_DEFAULT_form\", SOURCE_SELECT_DEFAULT)).strip().upper(),\r\n        \"ALLOWED_CLASSES\": _parse_csv_to_list(form_dict.get(\"ALLOWED_CLASSES_DEFAULT_form\", ALLOWED_CLASSES_DEFAULT), ALLOWED_CLASSES_DEFAULT),\r\n        \"RESET_CLASSES\": _parse_csv_to_list(form_dict.get(\"RESET_CLASSES_DEFAULT_form\", RESET_CLASSES_DEFAULT), RESET_CLASSES_DEFAULT),\r\n        \"RESET_HAS_PRIORITY\": _parse_bool(form_dict.get(\"RESET_HAS_PRIORITY_DEFAULT_form\", RESET_HAS_PRIORITY_DEFAULT), RESET_HAS_PRIORITY_DEFAULT),\r\n        \"DETECTOR_BOTH_POLICY\": str(form_dict.get(\"DETECTOR_BOTH_POLICY_DEFAULT_form\", DETECTOR_BOTH_POLICY_DEFAULT)).strip().lower(),\r\n        \"RESULT_OK_IS_ALLOWED\": _parse_bool(form_dict.get(\"RESULT_OK_IS_ALLOWED_DEFAULT_form\", RESULT_OK_IS_ALLOWED_DEFAULT), RESULT_OK_IS_ALLOWED_DEFAULT),\r\n        \"LOOP_NUMBER\": int(form_dict.get(\"LOOP_NUMBER_DEFAULT_form\", LOOP_NUMBER_DEFAULT)) if str(form_dict.get(\"LOOP_NUMBER_DEFAULT_form\", \"\")).strip() != \"\" else LOOP_NUMBER_DEFAULT,\r\n        \"FRAME_NUMBER\": int(form_dict.get(\"FRAME_NUMBER_DEFAULT_form\", FRAME_NUMBER_DEFAULT)) if str(form_dict.get(\"FRAME_NUMBER_DEFAULT_form\", \"\")).strip() != \"\" else FRAME_NUMBER_DEFAULT,\r\n        \"VERBOSE\": _parse_bool(form_dict.get(\"VERBOSE_DEFAULT_form\", VERBOSE_DEFAULT), VERBOSE_DEFAULT),\r\n    }\r\n\r\n    # Normalizace pro SOURCE_SELECT\r\n    P[\"SOURCE_SELECT\"] = _norm_src_type(P[\"SOURCE_SELECT\"]) if P[\"SOURCE_SELECT\"] else SOURCE_SELECT_DEFAULT\r\n    \r\n    # Normalizace politiky detektoru\r\n    if P[\"DETECTOR_BOTH_POLICY\"] not in (\"reset\", \"allowed\"):\r\n        P[\"DETECTOR_BOTH_POLICY\"] = DETECTOR_BOTH_POLICY_DEFAULT\r\n\r\n    return P\r\n\r\n# =========================\r\n# Stavové proměnné (globální, per instance)\r\n# =========================\r\nSTATE_IDLE = \"IDLE\"\r\nSTATE_DEBOUNCE = \"DEBOUNCE\"\r\nSTATE_CAPTURE = \"CAPTURE\"\r\nSTATE_WAIT_RESET = \"WAIT_RESET\"\r\n\r\ndef _init_globals():\r\n    if \"AI_STATE_2\" not in dir(__main__):\r\n        __main__.AI_STATE_2 = STATE_IDLE\r\n    if \"DEB_CNT_2\" not in dir(__main__):\r\n        __main__.DEB_CNT_2 = 0\r\n    if \"CAP_CNT_2\" not in dir(__main__):\r\n        __main__.CAP_CNT_2 = 0\r\n\r\ndef _reset_debounce():\r\n    __main__.DEB_CNT_2 = 0\r\n\r\ndef _reset_capture():\r\n    __main__.CAP_CNT_2 = 0\r\n\r\n# =========================\r\n# Vyhodnocení allowed/reset z tříd (on_classes)\r\n# =========================\r\ndef _eval_on_classes(context, P):\r\n    rects = context.get(\"detectedRectangles\") or []\r\n    src_sel = P[\"SOURCE_SELECT\"]\r\n    allowed_found_cls = False\r\n    reset_found_cls = False\r\n    allowed_found_det = False\r\n    reset_found_det = False\r\n    det_labels = set()\r\n\r\n    for r in rects:\r\n        st = _norm_src_type((r.get(\"source\") or {}).get(\"type\", r.get(\"type\", \"\")))\r\n        if src_sel not in (\"ANY\", st):\r\n            continue\r\n\r\n        if st == \"CLASSIFIER\":\r\n            top = _get_top_label_from_classifier(r)\r\n            if top:\r\n                if top in P[\"RESET_CLASSES\"]:\r\n                    reset_found_cls = True\r\n                elif top in P[\"ALLOWED_CLASSES\"]:\r\n                    allowed_found_cls = True\r\n\r\n        elif st == \"DETECTOR\":\r\n            labs = _get_all_labels_from_detector(r)\r\n            for lab in labs:\r\n                det_labels.add(lab)\r\n\r\n    # DETECTOR vyhodnocení\r\n    if src_sel in (\"DETECTOR\", \"ANY\"):\r\n        # Kontrola, zda detekce obsahují JAKOUKOLIV z povolených tříd\r\n        if any(l in P[\"ALLOWED_CLASSES\"] for l in det_labels):\r\n            allowed_found_det = True\r\n            \r\n        if any(l in P[\"RESET_CLASSES\"] for l in det_labels):\r\n            reset_found_det = True\r\n            \r\n        # Když v detektoru nastane současně allowed i reset:\r\n        if allowed_found_det and reset_found_det:\r\n            if P[\"DETECTOR_BOTH_POLICY\"] == \"reset\":\r\n                allowed_found_det = False\r\n            else:\r\n                reset_found_det = False\r\n\r\n    # Sloučení zdroje\r\n    if src_sel == \"CLASSIFIER\":\r\n        allowed_found = allowed_found_cls\r\n        reset_found = reset_found_cls\r\n    elif src_sel == \"DETECTOR\":\r\n        allowed_found = allowed_found_det\r\n        reset_found = reset_found_det\r\n    else:  # ANY – sloučit\r\n        allowed_found = allowed_found_cls or allowed_found_det\r\n        reset_found = reset_found_cls or reset_found_det\r\n        \r\n        if P[\"RESET_HAS_PRIORITY\"] and allowed_found and reset_found:\r\n            allowed_found = False\r\n\r\n    return allowed_found, reset_found\r\n\r\n# =========================\r\n# Vyhodnocení allowed/reset z resultu (on_result)\r\n# =========================\r\ndef _eval_on_result(context, P):\r\n    res = bool(context.get(\"result\", False))\r\n    if P[\"RESULT_OK_IS_ALLOWED\"]:\r\n        return (res is True), (res is False)\r\n    else:\r\n        return (res is False), (res is True)\r\n\r\n# =========================\r\n# Hlavní funkce\r\n# =========================\r\ndef main(context, form):\r\n    _init_globals()\r\n    P = _get_params(context, form)\r\n\r\n    context[\"ai_trigger_state_2\"] = __main__.AI_STATE_2\r\n\r\n    # Vyhodnocení vstupů podle zvoleného režimu\r\n    mode = str(P[\"MODE\"]).strip().lower()\r\n    if mode == \"on_result\":\r\n        allowed_found, reset_found = _eval_on_result(context, P)\r\n    else:  # \"on_classes\"\r\n        allowed_found, reset_found = _eval_on_classes(context, P)\r\n\r\n    if P[\"VERBOSE\"]:\r\n        print(f\"[AI-TRIG-2] MODE={mode} | SRC={P['SOURCE_SELECT']} | state={__main__.AI_STATE_2} | \"\r\n              f\"allowed={allowed_found} reset={reset_found} | DEB={__main__.DEB_CNT_2}/{P['LOOP_NUMBER']} | \"\r\n              f\"CAP={__main__.CAP_CNT_2}/{P['FRAME_NUMBER']}\")\r\n\r\n    # ========== IDLE ==========\r\n    if __main__.AI_STATE_2 == STATE_IDLE:\r\n        if reset_found and not allowed_found:\r\n            context[\"exit\"] = True\r\n            return\r\n\r\n        if allowed_found and not reset_found:\r\n            __main__.AI_STATE_2 = STATE_DEBOUNCE\r\n            _reset_debounce()\r\n            _reset_capture()\r\n            context[\"ai_trigger_state_2\"] = __main__.AI_STATE_2\r\n            context[\"exit\"] = True\r\n            return\r\n\r\n        if allowed_found and reset_found:\r\n            if P[\"RESET_HAS_PRIORITY\"]:\r\n                context[\"exit\"] = True\r\n                return\r\n        return\r\n\r\n    # ======== DEBOUNCE ========\r\n    if __main__.AI_STATE_2 == STATE_DEBOUNCE:\r\n        if reset_found or not allowed_found:\r\n            __main__.AI_STATE_2 = STATE_IDLE\r\n            _reset_debounce()\r\n            _reset_capture()\r\n            context[\"ai_trigger_state_2\"] = __main__.AI_STATE_2\r\n            context[\"exit\"] = True\r\n            return\r\n\r\n        __main__.DEB_CNT_2 += 1\r\n        if __main__.DEB_CNT_2 >= P[\"LOOP_NUMBER\"]:\r\n            __main__.AI_STATE_2 = STATE_CAPTURE\r\n            _reset_capture()\r\n            context[\"ai_trigger_state_2\"] = __main__.AI_STATE_2\r\n        else:\r\n            context[\"exit\"] = True\r\n            return\r\n\r\n    # ========= CAPTURE =========\r\n    if __main__.AI_STATE_2 == STATE_CAPTURE:\r\n        if reset_found or not allowed_found:\r\n            __main__.AI_STATE_2 = STATE_WAIT_RESET\r\n            context[\"ai_trigger_state_2\"] = __main__.AI_STATE_2\r\n            context[\"exit\"] = True\r\n            return\r\n\r\n        __main__.CAP_CNT_2 += 1\r\n\r\n        if __main__.CAP_CNT_2 >= P[\"FRAME_NUMBER\"]:\r\n            __main__.AI_STATE_2 = STATE_WAIT_RESET\r\n            context[\"ai_trigger_state_2\"] = __main__.AI_STATE_2\r\n        return\r\n\r\n    # ======== WAIT_RESET ========\r\n    if __main__.AI_STATE_2 == STATE_WAIT_RESET:\r\n        if reset_found:\r\n            __main__.AI_STATE_2 = STATE_IDLE\r\n            _reset_debounce()\r\n            _reset_capture()\r\n            context[\"ai_trigger_state_2\"] = __main__.AI_STATE_2\r\n            context[\"exit\"] = True\r\n            return\r\n\r\n        context[\"exit\"] = True\r\n        return\r\n\r\n    # Fallback\r\n    __main__.AI_STATE_2 = STATE_IDLE\r\n    context[\"ai_trigger_state_2\"] = __main__.AI_STATE_2\r\n    return","form":[{"id":1786963425729,"type":"select","label":"Základní režim","formKey":"MODE_DEFAULT_form","defaultValue":"on_result","options":"on_result;on_classes","visibility":""},{"id":1786966182956,"type":"checkbox","label":"RESET pokud NG (False = RESET pokud OK)","formKey":"RESULT_OK_IS_ALLOWED_DEFAULT_form","defaultValue":true,"visibility":"MODE_DEFAULT_form=on_result"},{"id":1786964578481,"type":"select","label":"Volba zdroje tříd pro on_classes","formKey":"SOURCE_SELECT_DEFAULT_form","defaultValue":"ANY","options":"CLASSIFIER;DETECTOR;ANY","visibility":"MODE_DEFAULT_form=on_classes"},{"id":1786964734101,"type":"text","label":"Třídy pro on_classes - ALLOWED","formKey":"ALLOWED_CLASSES_DEFAULT_form","defaultValue":"POZICE, ANY, SOME","visibility":"MODE_DEFAULT_form=on_classes"},{"id":1786965225273,"type":"text","label":"Třídy pro on_classes - RESET","formKey":"RESET_CLASSES_DEFAULT_form","defaultValue":"OUT, PODLAHA","visibility":"MODE_DEFAULT_form=on_classes"},{"id":1786965779369,"type":"checkbox","label":"Politika kolizí - RESET má prioritu","formKey":"RESET_HAS_PRIORITY_DEFAULT_form","defaultValue":true,"visibility":"MODE_DEFAULT_form=on_classes"},{"id":1786965942675,"type":"select","label":"Politika kolizí - both policy default (přeložit)","formKey":"DETECTOR_BOTH_POLICY_DEFAULT_form","defaultValue":"reset","options":"reset;default","visibility":"MODE_DEFAULT_form=on_classes"},{"id":1786966344228,"type":"number","label":"Počet snímků debounce","formKey":"LOOP_NUMBER_DEFAULT_form","min":1,"defaultValue":"1","visibility":""},{"id":1786966345586,"type":"number","label":"Počet snímků k propustění","formKey":"FRAME_NUMBER_DEFAULT_form","min":1,"max":"","defaultValue":"1","visibility":""},{"id":1786966499705,"type":"checkbox","label":"Verbose (DEBUG)","formKey":"VERBOSE_DEFAULT_form","defaultValue":true,"visibility":""}],"formValues":{"MODE_DEFAULT_form":"on_classes","RESET_HAS_PRIORITY_DEFAULT_form":true,"LOOP_NUMBER_DEFAULT_form":2,"RESULT_OK_IS_ALLOWED_DEFAULT_form":true,"ALLOWED_CLASSES_DEFAULT_form":"podlaha_zadni_dil_sk370","RESET_CLASSES_DEFAULT_form":"JEDE"},"showImagePreview":true,"editDate":1790149697994,"isActive":false},"version":"4.0.3"}