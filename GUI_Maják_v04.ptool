{"type":"CODE","module":{"label":"GUI_Maják_v04","id":2,"note":"","gpuSettings":[],"softDeletedDate":null,"type":"CODE","sourceCode":"import requests\nfrom pekat_communication import PEKAT\n\n#PEKAT.add_client_to_pekat(\"127.0.0.1\", 8000, \"ThisProject\")\n\ndef control_beacon(context, form):\n    \"\"\"\n    Ovládá maják na základě výsledku z contextu.\n    Hex příkaz se skládá ze tří proměnných:\n      - Siréna (2 znaky): \"00\" = vypnuta, \"11\" = siréna 1, \"21\" = siréna 2\n      - Blink (1 znak): \"0\" = trvale, \"1\" = bliká pomalu, \"2\" = bliká rychleji\n      - Color (1 znak): \"0\" = zhasnuto, \"1\" = červená, \"2\" = zelená, \"3\" = oranžová, \"4\" = modrá\n    \"\"\"\n    \n    # Hodnoty z formuláře\n    ipAdress_form = form[\"ipAdress_form\"]\n    portNo_form = form[\"portNo_form\"]\n    \n    sirenLoudnessOK_form = form[\"sirenLoudnessOK_form\"]\n    sirenColorOK_form = form[\"sirenColorOK_form\"]\n    lightModeOK_form = form[\"lightModeOK_form\"]\n    sirenAlarmOK_form = form[\"sirenAlarmOK_form\"]\n    \n    sirenLoudnessNOK_form = form[\"sirenLoudnessNOK_form\"]\n    sirenColorNOK_form = form[\"sirenColorNOK_form\"]\n    lightModeNOK_form = form[\"lightModeNOK_form\"]\n    sirenAlarmNOK_form = form[\"sirenAlarmNOK_form\"]\n    \n    test = context[\"globalData\"]\n    print(f\"test {test}\")\n    \n    # Nastavení IP adresy IoT portu masteru AL1306\n    ip_address = ipAdress_form\n    port = portNo_form         #\n    url = f\"http://{ip_address}/iolinkmaster/port[{port}]/iolinkdevice/pdout/setdata\"\n    headers = {\"Content-Type\": \"application/json\"}\n    \n    \n    # _____________________ docasne reseni protoze Codeblock - form - select vraci moznosti jako integer ____________________\n    \n    \n    #PEKAT.update_global_data(\"ThisProject\", {\"AlarmActive\": True})\n    \n    \n    colorTemporaryDict = {\n        '0': \"no_light\",\n        0: \"no_light\",      #funguje to nejak nahodne, jednou je to int, jednou string (podle me, kdyz dam default 0, tak to bere jako int, ale kdyz vyberu 0, tak jako string)\n        '1': \"red\",\n        '2': \"green\",\n        '3': \"orange\",\n        '4': \"blue\",\n        '5': \"violet\",\n        '6': \"tyrkys\",\n        '7': \"white\",\n        '8': \"yellow\"\n\n    }\n    \n    colorOK_key = colorTemporaryDict[sirenColorOK_form]\n    colorNOK_key = colorTemporaryDict[sirenColorNOK_form]\n    \n    \n    lightTemporaryDict = {\n        '0': \"light_on\",\n        0: \"light_on\",      #funguje to nejak nahodne, jednou je to int, jednou string (podle me, kdyz dam default 0, tak to bere jako int, ale kdyz vyberu 0, tak jako string)\n        '1': \"slow_blink\",\n        '2': \"blink\",\n        '3': \"fast_blink\",\n        '4': \"slow_flash\",\n        '5': \"flash\",\n        '6': \"fast_flash\"\n\n    }\n    \n    lightOK_key = lightTemporaryDict[lightModeOK_form]\n    lightNOK_key = lightTemporaryDict[lightModeNOK_form]\n    \n    \n    sirenTemporaryDict = {\n        '0': \"beep_off\",\n        0: \"beep_off\",      #funguje to nejak nahodne, jednou je to int, jednou string (podle me, kdyz dam default 0, tak to bere jako int, ale kdyz vyberu 0, tak jako string)\n        '1': \"beep1\",\n        '2': \"beep2\",\n        '3': \"beep3\",\n        '4': \"beep4\",\n        '5': \"beep5\",\n        '6': \"beep6\",\n        '7': \"beep7\"\n\n    }\n    \n    sirenOK_key = sirenTemporaryDict[sirenAlarmOK_form]\n    sirenNOK_key = sirenTemporaryDict[sirenAlarmNOK_form]\n    \n    \n    # ________________________________________________________________________________________________________________________\n    \n    # Slovnik pro form select barvy majacku\n    colorDict = {\n        \"no_light\": \"0\",\n        \"red\": \"1\",\n        \"green\": \"2\",\n        \"orange\": \"3\",\n        \"blue\": \"4\",\n        \"violet\":\"5\",\n        \"tyrkys\": \"6\",\n        \"white\": \"7\",\n        \"yellow\": \"8\"\n    }\n    \n    # Slovnik pro form select modu svetelne signaliyace majacku\n    lightDict = {\n        \"light_on\": \"0\",\n        \"slow_blink\": \"1\",\n        \"blink\": \"2\",\n        \"fast_blink\": \"3\",\n        \"slow_flash\": \"4\",\n        \"flash\": \"5\",\n        \"fast_flash\": \"6\"\n    }\n    \n    # Slovnik pro form select tonu majacku\n    sirenDict = {\n        \"beep_off\": \"00\",\n        \"beep1\": \"11\",\n        \"beep2\": \"21\",\n        \"beep3\": \"31\",\n        \"beep4\": \"41\",\n        \"beep5\": \"51\",\n        \"beep6\": \"61\",\n        \"beep7\": \"71\"\n    }\n    \n    \n    \n    \n    \n    payload2 = {\n        \"code\": 10,\n        \"cid\": 4711,  # identifikátor požadavku (lze libovolně měnit)\n        \"adr\": f\"/iolinkmaster/port[{port}]/iolinkdevice/pdin/getdata\",\n   \n    }\n    \n    url2 = f\"http://{ip_address}/iolinkmaster/port[{port}]/iolinkdevice/pdin/getdata\"\n    \n    response2 = requests.post(\n        url2,\n        json=payload2,\n        timeout=5)\n    \n    feedbackButtonState = response2.json()['data']['value'] # Načte hodnotu kapacitního senzoru majacku (0000-nestisknuto ; 0100-stisknuto)\n    globalAlarmActive = context[\"globalData\"][\"AlarmActive\"]\n      \n    print(f\"Status code getdata = {response2.status_code}\")\n    print(f\"Stuff getdata = \\n {feedbackButtonState}\")\n    \n    print(f\"AlarmActive = {globalAlarmActive}\")\n    \n    \n    if globalAlarmActive == False:\n        # OK: maják má být v normálním režimu\n        siren = sirenDict[sirenOK_key]  \n        light = lightDict[lightOK_key]   \n        color = colorDict[colorOK_key]\n    else:\n        # NOK: maják má být ve varovném režimu\n        siren = sirenDict[sirenNOK_key]  \n        light = lightDict[lightNOK_key]     \n        color = colorDict[colorNOK_key]\n        \n        if feedbackButtonState == \"0100\":\n            #PEKAT.update_global_data(\"ThisProject\", {\"AlarmActive\": False})\n            context[\"globalData\"][\"AlarmActive\"] = False\n    \n    \n    \n    \n    \n    \n    \n    # Výběr hodnot podle výsledku detekce v contextu\n    if context[\"result\"]:\n        # OK: maják má být v normálním režimu – žádná siréna, trvale svítí, zelená\n        #siren = sirenDict[sirenOK_key]  \n        #light = lightDict[lightOK_key]   \n        #color = colorDict[colorOK_key]\n        lol = 1\n    else:\n        # NOK: maják má být ve varovném režimu – siréna 2, pomalé blikání, červená\n        #PEKAT.update_global_data(\"ThisProject\", {\"AlarmActive\": True})\n        context[\"globalData\"][\"AlarmActive\"] = True\n    \n    # Sestavení výsledného hex příkazu\n    command = siren + light + color  # např. \"2111\" nebo \"0002\"\n    \n    # Sestavení payloadu pro POST požadavek\n    payload = {\n        \"code\": \"request\",\n        \"cid\": 1,  # identifikátor požadavku (lze libovolně měnit)\n        \"adr\": f\"/iolinkmaster/port[{port}]/iolinkdevice/pdout/setdata\",\n        \"data\": {\n            \"newvalue\": command\n        }\n    }\n    \n    \n    try:\n        response = requests.post(url, json=payload, headers=headers)\n        if response.status_code == 200:\n            print(\"Povel odeslán úspěšně:\", command)\n        else:\n            print(\"Chyba při odesílání povelu:\", response.status_code, response.text)\n    except Exception as e:\n        print(\"Výjimka při odesílání povelu:\", str(e))\n\ndef main(context, form):\n    # Funkce pouze ovládá maják na základě context[\"result\"]\n    control_beacon(context, form)\n\n","form":[{"id":1772096814526,"type":"text","label":"IP Adresa","formKey":"ipAdress_form","defaultValue":"192.168.0.25","visibility":""},{"id":1772096908983,"type":"number","label":"Port","formKey":"portNo_form","min":"1","max":"20","defaultValue":"1","visibility":""},{"id":1778766009375,"type":"number","label":"Režim: 0:normal ; 1:button","formKey":"capacitive_form","min":"","max":"","defaultValue":0,"visibility":""},{"id":1772187620540,"type":"number","label":"OK hlasiost majáčku","formKey":"sirenLoudnessOK_form","min":"0","max":"7","defaultValue":"1","visibility":""},{"id":1772187775364,"type":"number","label":"OK barva majáčku (off;r;g;o;b;m;c;w;y)","formKey":"sirenColorOK_form","min":"0","max":"8","defaultValue":"2","visibility":""},{"id":1772187816019,"type":"number","label":"OK blikání majáčku","formKey":"lightModeOK_form","min":"0","max":"6","defaultValue":0,"visibility":""},{"id":1772188667305,"type":"number","label":"OK alarm majáčku","formKey":"sirenAlarmOK_form","min":"0","max":"7","defaultValue":0,"visibility":""},{"id":1772188582073,"type":"number","label":"NOK hlasiost majáčku","formKey":"sirenLoudnessNOK_form","min":"0","max":"7","defaultValue":"1","visibility":""},{"id":1772188582449,"type":"number","label":"NOK barva majáčku (off;r;g;o;b;m;c;w;y)","formKey":"sirenColorNOK_form","min":"0","max":"8","defaultValue":"1","visibility":""},{"id":1772188582825,"type":"number","label":"NOK blikání majáčku","formKey":"lightModeNOK_form","min":"0","max":"6","defaultValue":"2","visibility":""},{"id":1772188667457,"type":"number","label":"NOK alarm majáčku","formKey":"sirenAlarmNOK_form","min":"0","max":"7","defaultValue":0,"visibility":""}],"formValues":{"ipAdress_form":"192.168.1.22","portNo_form":"1","sirenColorOK_form":"2","lightModeOK_form":"0","sirenColorNOK_form":"1","lightModeNOK_form":"0","sirenAlarmNOK_form":"3"},"showImagePreview":true,"editDate":1778766547947,"isActive":true},"version":"4.0.1"}