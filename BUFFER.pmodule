{"type":"CODE","module":{"label":"BUFFER","id":135,"type":"CODE","note":"","gpuSettings":[],"softDeletedDate":null,"sourceCode":"import __main__\r\nimport os\r\nimport numpy as np\r\nimport zipfile\r\nimport json\r\nimport cv2\r\nfrom PIL import Image, ImageDraw, ImageFont\r\nfrom datetime import datetime\r\n\r\n# =========================================================\r\n# POPIS FUNKCE BUFFER\r\n# =========================================================\r\n#Buffer funguje na principu ukládání obrázků do RAM. Konkrétně ukládá 24 snímků.\r\n#Iniciace ukládání do bufferu je pomocí result =  False (tedy NOK stav). \r\n#Trigger pro uložení bufferu je classifikátor, který detekuje prázdný stůl (v tomto konkretnim pripade).\r\n#Uložení se provode do ZIP souboru, který obsahuje 23 snímků a meta.json. Obsahuje i aktivační snímek - prázdný stůl.\r\n#\r\n#Reset bufferu se provádí pomocí result = True (OK snímky), tento reset je důležitý z pohledu podmínky uložení. Uložení se provede pouze tehdy, pokud je buffer plný. Stávalo se, že i když bylo vyhodnocení OK, tak při odebírání objektu byl stav NOK, jelikož detekované objekty byly mimo kameru.\r\n#Snímky v bufferu by se měly automaticky přepisovat. Pokud bude zachycen stav NOK, začnou se ukládat snímky. Po naplnění počtu se začnou přepisovat. (Toto se děje z důvodu toho, že NOK stav je zachycen v ranní fáze detekce (teprve při skládání/ montování). Tento stav je spíše nerohodný, ale systém ho vidí jako NOK)\r\n\r\n# =========================================================\r\n# VSTUPNI PROMENNE\r\n# =========================================================\r\n\r\ncesta_uloz = r\"C:\\Users\\Uživatel\\Downloads\\test_ukladani_snimku_rezerva_auta\"\r\npocet_snimku_v_bufferu = 24\r\n\r\n# =========================================================\r\n# NIC DETECTION, cesta k trigger třídě\r\n# =========================================================\r\ndef is_nic(rectangles):\r\n    for r in rectangles:\r\n        label = r[\"classNames\"][0]['label']\r\n        if label == \"NIC\":\r\n            return True\r\n    return False\r\n# =========================================================\r\n# VYKRESLENI RECTANGLŮ\r\n# =========================================================\r\ndef draw_rectangles(image, rectangles):\r\n    img_pil = Image.fromarray(image)\r\n    draw = ImageDraw.Draw(img_pil)\r\n    \r\n    font = ImageFont.truetype(\"arial.ttf\", 20)\r\n    \r\n    for r in rectangles:\r\n        x = int(r['x'])\r\n        y = int(r['y'])\r\n        w = int(r['width'])\r\n        h = int(r['height'])\r\n        \r\n        try:\r\n            label = r[\"classNames\"][0]['label']\r\n        except:\r\n            label = \"UNKNOWN\"\r\n            \r\n        #conf = r.get('confidence', None)\r\n        #if conf is not None:\r\n        #    text = f\"{label} ({conf:.2f})\"\r\n        #else:\r\n        #    text = label        \r\n        \r\n        acc = None\r\n        \r\n        if 'classNames' in r and len (r['classNames']) > 0:\r\n            acc = r['classNames'][0]['confidence']\r\n\r\n        #if acc is None:\r\n        #    acc = r.get('confidence', None)\r\n            \r\n        if acc is not None:\r\n            text = f\"{label} ({acc*100:.2f}%)\"\r\n        else:\r\n            text = label\r\n            \r\n        try:\r\n            color = tuple(r['classNames'][0].get('color_bgr', [0, 255, 0]))\r\n        except:\r\n            color = (0, 0, 255)        \r\n        label = r['classNames'][0]['label']\r\n        \r\n        draw.rectangle([x,y, x+w, y+h], outline = (255, 0, 0), width = 2)\r\n        draw.text((x, y- 20), label, fill= (255, 0, 0), width = 2)\r\n \r\n    return np.array(img_pil)\r\n        \r\n    #    except:\r\n    #        label = \"UNKNOWN\"\r\n    #        \r\n    #    conf = r.get('confidence', None)\r\n    #    if conf is not None:\r\n    #        text = f\"{label} ({conf:.2f})\"\r\n    #    else:\r\n    #        text = label\r\n    #        \r\n    #    color = (0,0,255)\r\n    #    \r\n    #    cv2.putText(img, text, (x,y - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 1, cv2.LINE_AA)\r\n    #    \r\n    #return img\r\n\r\n\r\n# =========================================================\r\n# INIT GLOBALS\r\n# =========================================================\r\ndef initialize_globals():\r\n    if not 'image_buffer' in dir(__main__):\r\n        __main__.image_buffer = []\r\n\r\n    if not 'nok_seen' in dir(__main__):\r\n        __main__.nok_seen = False\r\n\r\n    if not 'nic_last_frame' in dir(__main__):\r\n        __main__.nic_last_frame = False\r\n\r\n\r\n# =========================================================\r\n# SAVE BUFFER\r\n# =========================================================\r\ndef save_buffer(buffer, save_path, context):\r\n    try:\r\n        if len(buffer) == 0:\r\n            return False\r\n\r\n        if not os.path.exists(save_path):\r\n            os.makedirs(save_path)\r\n\r\n        timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S_%f\")\r\n        zip_filename = f\"{save_path}/buffer_{timestamp}.zip\"\r\n        \r\n        with zipfile.ZipFile(zip_filename, 'w', compression=zipfile.ZIP_DEFLATED) as zf:\r\n            \r\n            for i, frame in enumerate(buffer):\r\n                success, encoded = cv2.imencode('.jpg', frame)\r\n                \r\n                if not success:\r\n                    continue\r\n                \r\n                zf.writestr(f\"frame_{i:03d}.jpg\", encoded.tobytes())\r\n                \r\n            metadata = {\r\n                \"timestamp\": timestamp,\r\n                \"frame_count\": len(buffer),\r\n                \"result\": context.get('result'),\r\n                \"completeTime\": context.get('completeTime')\r\n            }\r\n            \r\n            zf.writestr(\"meta.json\", json.dumps(metadata, indent=2))\r\n            \r\n        return True\r\n        \r\n    except Exception as e:\r\n        context['buffer_error'] = str(e)\r\n        return False\r\n    \r\n\r\n# =========================================================\r\n# MAIN\r\n# =========================================================\r\ndef main(context):\r\n    initialize_globals()\r\n\r\n    buffer_size = pocet_snimku_v_bufferu\r\n    save_path = cesta_uloz\r\n\r\n    image = context.get('image')\r\n    rectangles = context.get('detectedRectangles', [])\r\n\r\n    # =====================================================\r\n    # VALIDACE\r\n    # =====================================================\r\n    if image is None or not isinstance(image, np.ndarray):\r\n        context['buffer_error'] = \"Invalid image\"\r\n        return\r\n\r\n    # =====================================================\r\n    # BUFFER (FIFO)\r\n    # =====================================================\r\n    annotated = draw_rectangles(image, rectangles)\r\n    __main__.image_buffer.append(annotated)\r\n\r\n    if len(__main__.image_buffer) > buffer_size:\r\n        __main__.image_buffer.pop(0)\r\n        \r\n    # =====================================================\r\n    # LOGIKA\r\n    # =====================================================\r\n    result = context.get('result')\r\n\r\n    # zapamatuj si NOK\r\n    if result is False:\r\n        __main__.nok_seen = True\r\n\r\n    # NIC detekce\r\n    nic = is_nic(rectangles)\r\n\r\n    # náběžná hrana NIC (aby se to nespouštělo pořád)\r\n    nic_edge = nic and not __main__.nic_last_frame\r\n\r\n    saved = False\r\n\r\n    # =====================================================\r\n    # TRIGGER\r\n    # =====================================================\r\n    if nic_edge and __main__.nok_seen:\r\n        if len(__main__.image_buffer) == buffer_size:\r\n            saved = save_buffer(__main__.image_buffer, save_path, context)\r\n\r\n        # reset po uložení\r\n        __main__.nok_seen = False\r\n    \r\n    # =====================================================\r\n    # UPDATE STAVU\r\n    # =====================================================\r\n    __main__.nic_last_frame = nic\r\n\r\n    # =====================================================\r\n    # KONTROLA, POKUD JE OK RESETUJ BUFFER\r\n    # =====================================================\r\n   #result = context.get('result')\r\n    if result is True:\r\n       __main__.image_buffer = []\r\n       __main__.nok_seen = False\r\n       __main__.nic_last_frame = False\r\n  \r\n    #if result is False:\r\n        #__main__.nok_seen = True\r\n   \r\n   \r\n    # =====================================================\r\n    # FILTER (terminální větev)\r\n    # =====================================================\r\n    # propustí jen OK kusy\r\n    if result is True:\r\n        context['exit'] = False\r\n    else:\r\n        context['exit'] = True\r\n    \r\n    # =====================================================\r\n    # CODING DEBUG\r\n    # =====================================================\r\n    \r\n    #__main__.image_buffer = []\r\n    print(f\"Images in buffer: {len(__main__.image_buffer)}/{buffer_size}\")\r\n    print(f\"Result: {result} ; nic: {nic} ; nic_edge: {nic_edge} ; saved: {saved}\")\r\n    print (f\"RESET TRIGGERED(OK frame)\")\r\n    # =====================================================\r\n    # DEBUG INFO\r\n    # =====================================================\r\n    context['buffer_length'] = len(__main__.image_buffer)\r\n    context['nok_seen'] = __main__.nok_seen\r\n    context['nic_detected'] = nic\r\n    context['nic_edge'] = nic_edge\r\n    context['buffer_saved'] = saved","form":[],"formValues":{},"showImagePreview":true,"editDate":1781262540270,"isActive":true},"version":"3.19.3"}