{"type":"CODE","module":{"label":"Vypisovator_v01","id":23,"note":"Modul pro vykreslení uživatelského textu, data a dalších dynamických řádků do rohu obrazu.","gpuSettings":[],"softDeletedDate":null,"type":"CODE","sourceCode":"import cv2\nimport numpy as np\nfrom datetime import datetime\n\n\ndef main(context, form):\n    custom_text = str(form.get(\"custom_text\", \"Pekat Vision\"))\n    show_datetime = int(form.get(\"show_datetime\", 3))\n    corner_form = int(form.get(\"corner_form\", 1))\n    colour_form = int(form.get(\"colour_form\", 1))\n    scale_form = float(form.get(\"scale_form\", 1.0))\n    thickness_form = int(form.get(\"thickness_form\", 2))\n    offset_x_form = int(form.get(\"offset_x_form\", 20))\n    offset_y_form = int(form.get(\"offset_y_form\", 30))\n\n    # -------------------------------------------------------------------------\n    # DYNAMICKÉ ŘÁDKY Z KÓDU\n    # Sem můžete vložit jakékoliv proměnné z contextu nebo vlastní logiky\n    # -------------------------------------------------------------------------\n    extra_lines = [\n        # Přiklady použití:\n        #f\"Pocet OK: {context.get('ok_count', 0)}\",\n        #f\"Kamera: {context.get('camera_name', 'Cam_01')}\",\n    ]\n\n    vypisovator(\n        context=context,\n        text=custom_text,\n        show_datetime=show_datetime,\n        corner=corner_form,\n        colour=colour_form,\n        scale=scale_form,\n        thickness=thickness_form,\n        offset_x=offset_x_form,\n        offset_y=offset_y_form,\n        extra_lines=extra_lines,\n    )\n\n\ndef vypisovator(\n    context,\n    text=\"\",\n    show_datetime=3,\n    corner=1,\n    colour=1,\n    scale=1.0,\n    thickness=2,\n    offset_x=20,\n    offset_y=30,\n    extra_lines=None,\n):\n    if \"image\" not in context or context[\"image\"] is None:\n        return\n\n    image = context[\"image\"]\n    h, w = image.shape[:2]\n\n    # Převodník barev (OpenCV používá BGR)\n    quick_colours = {\n        0: [0, 0, 255],    # r (Červená)\n        1: [0, 255, 0],    # g (Zelená)\n        2: [255, 0, 0],    # b (Modrá)\n        3: [255, 255, 0],  # c (Akvamarínová / Cyan)\n        4: [255, 0, 255],  # m (Fialová / Magenta)\n        5: [0, 255, 255],  # y (Žlutá)\n        6: [0, 0, 0],      # k (Černá)\n        7: [255, 255, 255] # w (Bílá)\n    }\n\n    bgr_color = quick_colours.get(colour, [0, 255, 0])\n\n    # Sestavení řádků pro výpis\n    lines = []\n    if text:\n        lines.append(text)\n\n    now = datetime.now()\n    if show_datetime == 1:\n        lines.append(now.strftime(\"%Y-%m-%d\"))\n    elif show_datetime == 2:\n        lines.append(now.strftime(\"%H:%M:%S\"))\n    elif show_datetime == 3:\n        lines.append(now.strftime(\"%Y-%m-%d %H:%M:%S\"))\n\n    if extra_lines:\n        for line in extra_lines:\n            if line:\n                lines.append(str(line))\n\n    if not lines:\n        return\n\n    font = cv2.FONT_HERSHEY_SIMPLEX\n    (sample_w, sample_h), baseline = cv2.getTextSize(\"Ay\", font, scale, thickness)\n    line_height = int((sample_h + baseline) * 1.5)\n    total_lines = len(lines)\n\n    for idx, line_str in enumerate(lines):\n        (text_w, text_h), _ = cv2.getTextSize(line_str, font, scale, thickness)\n\n        # Výpočet X podle rohu\n        if corner in (0, 2):  # Levý horní (0) nebo Levý dolní (2)\n            x = offset_x\n        else:                 # Pravý horní (1) nebo Pravý dolní (3)\n            x = w - text_w - offset_x\n\n        # Výpočet Y podle rohu\n        if corner in (0, 1):  # Horní rohy\n            y = offset_y + (idx + 1) * line_height\n        else:                 # Dolní rohy\n            y = h - offset_y - (total_lines - 1 - idx) * line_height\n\n        cv2.putText(\n            image,\n            line_str,\n            (int(x), int(y)),\n            font,\n            scale,\n            bgr_color,\n            thickness,\n            cv2.LINE_AA\n        )\n\n    context[\"image\"] = image\n","form":[{"id":1777375000001,"type":"text","label":"Text k vypisani","formKey":"custom_text","defaultValue":"Pekat Vision","visibility":""},{"id":1777375000002,"type":"number","label":"Datum/Cas {0: Vypnuto, 1: Jen datum, 2: Jen cas, 3: Datum a cas}","formKey":"show_datetime","min":"0","max":"3","defaultValue":"3","visibility":""},{"id":1777375000003,"type":"number","label":"Roh {0: Levý horní, 1: Pravý horní, 2: Levý dolní, 3: Pravý dolní}","formKey":"corner_form","min":"0","max":"3","defaultValue":"1","visibility":""},{"id":1777375000004,"type":"number","label":"Barva {0:r, 1:g, 2:b, 3:c, 4:m, 5:y, 6:k, 7:w}","formKey":"colour_form","min":"0","max":"7","defaultValue":"1","visibility":""},{"id":1777375000005,"type":"number","label":"Velikost pisma (scale)","formKey":"scale_form","min":"0.1","max":"10","defaultValue":"1.0","visibility":""},{"id":1777375000006,"type":"number","label":"Tloustka pisma (px)","formKey":"thickness_form","min":"1","max":"10","defaultValue":"2","visibility":""},{"id":1777375000007,"type":"number","label":"Odsazeni X [px]","formKey":"offset_x_form","min":"0","max":"","defaultValue":"20","visibility":""},{"id":1777375000008,"type":"number","label":"Odsazeni Y [px]","formKey":"offset_y_form","min":"0","max":"","defaultValue":"20","visibility":""},{"id":1790058139854,"type":"select","label":"example dropdown","formKey":"example dropdown","defaultValue":"moznost1","options":"moznost1;moznost2","visibility":""},{"id":1790058298517,"type":"text","label":"Example_format","formKey":"example_format","defaultValue":"DD-MM_HH:mm:ss","visibility":""}],"formValues":{"custom_text":"Pekat Vision","show_datetime":"3","corner_form":0,"colour_form":7,"scale_form":2,"thickness_form":4,"offset_x_form":50,"offset_y_form":50},"showImagePreview":true,"editDate":1790058401590,"isActive":false},"version":"4.0.3"}