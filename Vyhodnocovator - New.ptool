{"type":"CODE","module":{"label":"Vyhodnocovator - New","id":54,"note":"Když obsahuje položky deklarované na začátku kódu, dá OK, jinak NoK","gpuSettings":[],"softDeletedDate":null,"type":"CODE","sourceCode":"from collections import Counter\nfrom pekat_communication import PEKAT\n\ndef GetSofisVariables(context, form):   # Toto je zatím placeholder, funkce bude získávat informace (požadované díly, typ polystyrenu etc.)\n    pass\n\ndef GetShape(context) -> dict:\n    '''\n    Returns information about shape of the foam\n    in the form of a dictionary from CLASSIFIER output.\n    Possible keywords are: 'confidence' ; 'id' ; 'label' ; 'color'\n    \n    (Zatím se nepoužívá, možná až budou data se Sofis)\n    '''\n    \n    detectedRectangles = context[\"detectedRectangles\"]  # Ziska z aktualniho snimku vsechny detekovane objekty (do budoucna by slo opet nejak osetrit)\n    shape = detectedRectangles[0][\"classNames\"][0]  #Zatim beru to prvni, protoze to vypada, ze je to serazeny od nejvyssi hodnoty confidence, ale do prod by to chtelo nejak osetrit asi\n    return shape\n    \ndef GetItems(context) -> dict:\n    '''\n    Returns items detected in the foam\n    in the form of dictionaries from DETECTOR output.\n    Possible keywords are: 'confidence' ; 'id' ; 'label' ; 'color'\n    '''\n    \n    detectedRectangles = context[\"detectedRectangles\"]  # Ziska z aktualniho snimku vsechny detekovane objekty (do budoucna by slo opet nejak osetrit)\n    #itemRectangles = detectedRectangles[1:] # Vybere všechny kromě prvního (první rectangle je klasifikator tvaru) ale do budoucna by to chtělo asi nějak ošetřit\n    itemRectangles = detectedRectangles # Po přidání sjednocení se (nevím proč) odebere z \"Detected rectangles\" výsledek klasifikátoru a můžeme vzít všechny výsledky z \"Detected rectangles\"\n    \n    itemClassNames = []     # vytvoří list plný slovníků \"classNames\", když takový nenajde, vrátí []\n    for rect in itemRectangles:\n        sourceType = rect.get(\"source\", {}).get(\"type\", []) # Zjistí z jakého modulu daný detekovaný \"rectangle\" pochází\n        \n        if sourceType == \"DETECTOR\":    # Pokud daný detekovaný \"rectangle\" pochází z \"DETECTORu\", pokračuje s ním dál a připojí ho k listu itemClassNames, pokud nepochází z \"DETECTORu\", zahodí ho\n            itemClassNames.append(rect.get(\"classNames\", []))  \n        else:\n            continue\n    \n    \n    itemCounts = Counter()  # Prealokace prázdného counteru\n    for rect in itemClassNames:     # Vytahá si výsledky klasifikátoru \"label\" a spočítá, kolik je ve snímku jakých labelů\n        if not rect:\n            continue\n        label = rect[0].get(\"label\")\n        if label is None:\n            continue\n        itemCounts[label] += 1\n        \n    return itemCounts\n    \ndef GetExpected(context):\n    '''\n    Returns items expected in the foam\n    \n    Mělo by to nějak rozparsovat data získaná ze Sofisu, zatím to jen získává data z globalData projektu.\n    Nakonec to bez toho Sofisu nepoužívám a data ukládám zatím přímo do lokálních proměnných \"expectedItems_koule\" a \"expectedItems_bezKoule\"\n    '''\n    result = context[\"globalData\"]\n    return result\n\ndef main(context, form):\n    expected = GetExpected(context)\n    #expectedShape = expected[\"expectedShape\"]\n    \n    '''\n    Tady si nastavím jaká kombinace věcí by měla být v plném polystyrenu\n    Momentálně tady jsou 2 možnosti:\n        - koule\n        - bezKoule\n        \n    Jelikož zatím není přístup k datům ze Sofisu, tak označí snímek jako OK, pokud jsou detekovány tyto objekty:\n    '''\n    expectedItems_koule = {  # Můžou být: \"Stěna\" ; \"Klika_hever\" ; \"Hever\" ; \"Koule\" ; \"Háček\" ; \"Klíč\" ; \"pena\"\n        \"Emulze\":      1,\n        \"Hever\":       0,\n        \"Háček\":       1,\n        \"Klika_hever\": 0,   \n        \"Klíč\":        0,\n        \"Koule\":       1,\n        \"Oko\":         1,\n        \"Stěna\":       0,\n    }\n    expectedItems_bezKoule = {  # Můžou být: \"Stěna\" ; \"Klika_hever\" ; \"Hever\" ; \"Koule\" ; \"Háček\" ; \"Klíč\" ; \"pena\"\n        \"Emulze\":      1,\n        \"Hever\":       0,\n        \"Háček\":       1,\n        \"Klika_hever\": 0,   \n        \"Klíč\":        0,\n        \"Koule\":       0,\n        \"Oko\":         1,\n        \"Stěna\":       0,\n    }\n    \n    expectedItems_koule = Counter(expectedItems_koule)          # Převede dicty na typ Counter\n    expectedItems_bezKoule = Counter(expectedItems_bezKoule)    #\n    \n    expectedItems_koule = +expectedItems_koule          # Zahodí nulové a záporné hodnoty počtů pryč\n    expectedItems_bezKoule = +expectedItems_bezKoule    #\n    \n    #actualShape = GetShape(context)[\"label\"]\n    actualItems = Counter(GetItems(context))    # Zjistí kolik jakých itemů je detekováno ve snímku\n    \n    missingItems_koule = expectedItems_koule - actualItems          # Rozdíl toho co tam má být vs. co tam skutečně je \n    missingItems_bezKoule = expectedItems_bezKoule - actualItems    #   aka. <> 0 jen když tam něco chybí, když přebývá, tak jo\n    #extraItems = actualItems - expectedItems\n    \n    nO_missingItems_koule = sum(missingItems_koule.values())        # Číslo, kolik chybí věcí ve snímku\n    nO_missingItems_bezKoule = sum(missingItems_bezKoule.values())  #\n    #nO_etraItems = sum(extraItems.values())\n    \n    MissingItemsOK_Count = int(form[\"MissingItemsOK_Count_Form\"])    # Z formu si vytáhne hodnotu, kolik dílů může na snímku chybět, aby byl stále označen jako OK\n    \n    # Když je počet chybějících věcí menší, než hodnota \"MissingItemsOK_Count\", nastaví True\n    if 0 <= nO_missingItems_koule <= MissingItemsOK_Count:\n        okExact_koule = True\n    else:\n        okExact_koule = False\n    \n    if 0 <= nO_missingItems_bezKoule <= MissingItemsOK_Count:\n        okExact_bezKoule = True\n    else:\n        okExact_bezKoule = False    \n\n\n    # Pokud je alespoň jeden z výsledků True, nastaví snímek jako OK, tedy zelený (AI trigger s tím potom pracuje v dalších Modulech pro ukládání snímků)\n    if okExact_koule or okExact_bezKoule:\n        context[\"result\"] = True\n    else:\n        context[\"result\"] = False","form":[{"id":1775546655842,"type":"number","label":"How many items can be missing for an image to be labeled as OK","formKey":"MissingItemsOK_Count_Form","min":"0","max":"6","defaultValue":0,"visibility":""}],"formValues":{"MissingItemsOK_Count_Form":"0"},"showImagePreview":true,"editDate":1776940304884,"isActive":true},"version":"4.0.1"}