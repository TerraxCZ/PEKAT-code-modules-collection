{"type":"CODE","module":{"label":"Rectangle_Mazator_v01","id":27,"note":"Debug & Filtr (mazání) Obdélníků (Filter Detected Rectangles)","gpuSettings":[],"softDeletedDate":null,"type":"CODE","sourceCode":"import cv2\r\nimport numpy as np\r\n\r\n\r\ndef draw_table_on_image(image, data, ids_to_delete):\r\n    \"\"\"Vykreslí poloprůhlednou tabulku s daty přímo do pravého horního rohu obrázku.\"\"\"\r\n    if not data:\r\n        return image\r\n\r\n    h_img, w_img = image.shape[:2]\r\n\r\n    # Konfigurace písma a rozměrů tabulky\r\n    font = cv2.FONT_HERSHEY_SIMPLEX\r\n    font_scale = 0.5\r\n    thickness = 1\r\n    line_height = 25\r\n    padding = 10\r\n\r\n    # Definice sloupců\r\n    headers = [\"ID\", \"SRC\", \"LABEL\", \"CONF\", \"STAV\"]\r\n    rows = []\r\n    for item in data:\r\n        status = \"SMAZANO\" if item[\"id\"] in ids_to_delete else \"OK\"\r\n        rows.append(\r\n            [\r\n                str(item[\"id\"]),\r\n                str(item[\"src\"]),\r\n                str(item[\"label\"])[:15],  # Oříznutí dlouhých názvů\r\n                f\"{item['conf']:.2f}\",\r\n                status,\r\n            ]\r\n        )\r\n\r\n    # Výpočet šířky jednotlivých sloupců\r\n    col_widths = []\r\n    for i, h in enumerate(headers):\r\n        max_w = cv2.getTextSize(h, font, font_scale, thickness)[0][0]\r\n        for row in rows:\r\n            w = cv2.getTextSize(row[i], font, font_scale, thickness)[0][0]\r\n            if w > max_w:\r\n                max_w = w\r\n        col_widths.append(max_w + 15)\r\n\r\n    table_w = sum(col_widths) + 2 * padding\r\n    table_h = line_height * (len(rows) + 1) + 2 * padding\r\n\r\n    # Umístění do pravého horního rohu\r\n    start_x = max(10, w_img - table_w - 20)\r\n    start_y = 20\r\n\r\n    # Vytvoření poloprůhledného pozadí pod tabulkou (ztmavení)\r\n    overlay = image.copy()\r\n    cv2.rectangle(\r\n        overlay,\r\n        (start_x, start_y),\r\n        (start_x + table_w, start_y + table_h),\r\n        (20, 20, 20),\r\n        -1,\r\n    )\r\n    cv2.addWeighted(overlay, 0.75, image, 0.25, 0, image)\r\n\r\n    # Vykreslení hlavičky tabulky\r\n    curr_y = start_y + padding + 15\r\n    curr_x = start_x + padding\r\n\r\n    for i, head in enumerate(headers):\r\n        cv2.putText(\r\n            image,\r\n            head,\r\n            (curr_x, curr_y),\r\n            font,\r\n            font_scale,\r\n            (0, 255, 255),\r\n            thickness + 1,\r\n            cv2.LINE_AA,\r\n        )\r\n        curr_x += col_widths[i]\r\n\r\n    # Čára pod hlavičkou\r\n    cv2.line(\r\n        image,\r\n        (start_x + padding, curr_y + 5),\r\n        (start_x + table_w - padding, curr_y + 5),\r\n        (100, 100, 100),\r\n        1,\r\n    )\r\n\r\n    # Vykreslení jednotlivých řádků\r\n    for row in rows:\r\n        curr_y += line_height\r\n        curr_x = start_x + padding\r\n        is_deleted = row[4] == \"SMAZANO\"\r\n        color = (0, 0, 255) if is_deleted else (0, 255, 0)\r\n\r\n        for i, val in enumerate(row):\r\n            cv2.putText(\r\n                image,\r\n                val,\r\n                (curr_x, curr_y),\r\n                font,\r\n                font_scale,\r\n                color,\r\n                thickness,\r\n                cv2.LINE_AA,\r\n            )\r\n            curr_x += col_widths[i]\r\n\r\n    # Vnější rámeček tabulky\r\n    cv2.rectangle(\r\n        image,\r\n        (start_x, start_y),\r\n        (start_x + table_w, start_y + table_h),\r\n        (150, 150, 150),\r\n        1,\r\n    )\r\n    return image\r\n\r\n\r\ndef main(context, form):\r\n    rectangles = context.get(\"detectedRectangles\", [])\r\n\r\n    # Načtení parametrů z formuláře\r\n    debug = form.get(\"debug_mode\", False)\r\n    if isinstance(debug, str):\r\n        debug = debug.lower() in (\"true\", \"1\", \"yes\")\r\n\r\n    show_table = form.get(\"show_table_in_image\", False)\r\n    if isinstance(show_table, str):\r\n        show_table = show_table.lower() in (\"true\", \"1\", \"yes\")\r\n\r\n    delete_ids_str = str(form.get(\"delete_ids\", \"\"))\r\n\r\n    # 1. PARSOVÁNÍ ID K ODSTRANĚNÍ\r\n    ids_to_delete = set()\r\n    if delete_ids_str.strip():\r\n        clean_str = delete_ids_str.replace(\";\", \",\").replace(\" \", \",\")\r\n        for item in clean_str.split(\",\"):\r\n            item = item.strip()\r\n            if item.isdigit():\r\n                ids_to_delete.add(int(item))\r\n\r\n    # 2. DEBUG KRESLENÍ DO OBRÁZKU\r\n    if debug and \"image\" in context and context[\"image\"] is not None:\r\n        image = context[\"image\"]\r\n        h_img, w_img = image.shape[:2]\r\n        table_data = []\r\n\r\n        for rect in rectangles:\r\n            rect_id = rect.get(\"id\", \"N/A\")\r\n            conf = rect.get(\"confidence\", 0.0)\r\n\r\n            # Získání zdroje\r\n            src = rect.get(\"source\", {})\r\n            src_type = str(src.get(\"type\", \"UNKNOWN\"))\r\n            if \".\" in src_type:\r\n                src_type = src_type.split(\".\")[-1]\r\n\r\n            # Získání třídy (label)\r\n            class_names = rect.get(\"classNames\", [])\r\n            label = \"N/A\"\r\n            if class_names and isinstance(class_names, list):\r\n                first_cls = class_names[0]\r\n                if isinstance(first_cls, dict):\r\n                    label = first_cls.get(\"label\", \"N/A\")\r\n                else:\r\n                    label = str(first_cls)\r\n\r\n            is_deleted = rect_id in ids_to_delete\r\n\r\n            # Uložení dat pro tabulku\r\n            table_data.append(\r\n                {\r\n                    \"id\": rect_id,\r\n                    \"src\": src_type,\r\n                    \"label\": label,\r\n                    \"conf\": conf,\r\n                }\r\n            )\r\n\r\n            # Vykreslení obdélníku a ID\r\n            x = int(rect.get(\"x\", 0))\r\n            y = int(rect.get(\"y\", 0))\r\n            w = int(rect.get(\"width\", 0))\r\n            h = int(rect.get(\"height\", 0))\r\n\r\n            x1, y1 = max(0, x), max(0, y)\r\n            x2, y2 = min(w_img, x + w), min(h_img, y + h)\r\n\r\n            color = (0, 0, 255) if is_deleted else (0, 255, 0)\r\n            cv2.rectangle(image, (x1, y1), (x2, y2), color, 2)\r\n\r\n            label_text = f\"ID:{rect_id} | {src_type}\"\r\n            cv2.putText(\r\n                image,\r\n                label_text,\r\n                (x1 + 5, max(20, y1 + 25)),\r\n                cv2.FONT_HERSHEY_SIMPLEX,\r\n                0.6,\r\n                color,\r\n                2,\r\n                cv2.LINE_AA,\r\n            )\r\n\r\n        # Vykreslení tabulky do obrázku (pouze pokud je povolená ve formuláři)\r\n        if show_table:\r\n            image = draw_table_on_image(image, table_data, ids_to_delete)\r\n\r\n        context[\"image\"] = image\r\n\r\n    # 3. FILTRACE / SMAZÁNÍ RECTANGLŮ PODLE ID\r\n    if ids_to_delete:\r\n        filtered_rectangles = [\r\n            r for r in rectangles if r.get(\"id\") not in ids_to_delete\r\n        ]\r\n        context[\"detectedRectangles\"] = filtered_rectangles","form":[{"id":1790151700377,"type":"checkbox","label":"Debug (zobrazit ID a zdroje)","formKey":"debug_mode","defaultValue":false,"visibility":""},{"id":1790152182724,"type":"checkbox","label":"Zobrazit tabulku v obrázku","formKey":"show_table_in_image","defaultValue":false,"visibility":"debug_mode"},{"id":1790151722983,"type":"text","label":"ID k odstranění (oddělené čárkou)","formKey":"delete_ids","defaultValue":"","visibility":""}],"formValues":{"debug_mode":false,"delete_ids":"0","show_table_in_image":true},"showImagePreview":true,"editDate":1790152269763,"isActive":true},"version":"4.0.3"}