{"type":"CODE","module":{"label":"Ukladator_v01","id":25,"note":"Custom script to save images","gpuSettings":[],"softDeletedDate":null,"type":"CODE","sourceCode":"import os\r\nfrom datetime import datetime\r\nimport cv2\r\nimport numpy as np\r\n\r\n# Mapování textových názvů na konstanty OpenCV\r\nCOLORMAP_DICT = {\r\n    \"JET\": cv2.COLORMAP_JET,\r\n    \"HOT\": cv2.COLORMAP_HOT,\r\n    \"TURBO\": getattr(cv2, \"COLORMAP_TURBO\", cv2.COLORMAP_JET),\r\n    \"VIRIDIS\": getattr(cv2, \"COLORMAP_VIRIDIS\", cv2.COLORMAP_JET),\r\n    \"INFERNO\": getattr(cv2, \"COLORMAP_INFERNO\", cv2.COLORMAP_JET),\r\n    \"MAGMA\": getattr(cv2, \"COLORMAP_MAGMA\", cv2.COLORMAP_JET),\r\n    \"PLASMA\": getattr(cv2, \"COLORMAP_PLASMA\", cv2.COLORMAP_JET),\r\n    \"RAINBOW\": cv2.COLORMAP_RAINBOW,\r\n    \"HSV\": cv2.COLORMAP_HSV,\r\n}\r\n\r\n\r\ndef hex_to_bgr(hex_str):\r\n    \"\"\"Převede HEX barvu (#6366F1 nebo #ff0000) na BGR tuple pro OpenCV.\"\"\"\r\n    if not hex_str or not isinstance(hex_str, str):\r\n        return (0, 255, 0)  # Výchozí zelená\r\n\r\n    hex_str = hex_str.lstrip(\"#\")\r\n    if len(hex_str) != 6:\r\n        return (0, 255, 0)\r\n\r\n    try:\r\n        r = int(hex_str[0:2], 16)\r\n        g = int(hex_str[2:4], 16)\r\n        b = int(hex_str[4:6], 16)\r\n        return (b, g, r)  # OpenCV používá BGR pořadí\r\n    except ValueError:\r\n        return (0, 255, 0)\r\n\r\n\r\ndef draw_heatmaps(\r\n    img, heatmaps, alpha=0.5, threshold_pct=0.0, colormap_name=\"JET\"\r\n):\r\n    \"\"\"Přeloží heatmapu z context.heatmaps přes obrázek s vybranou barevnou paletou\r\n\r\n    (colormap_name) a prahem (threshold_pct).\r\n    \"\"\"\r\n    if not heatmaps or alpha <= 0:\r\n        return img\r\n\r\n    img_h, img_w = img.shape[:2]\r\n    result = img.copy()\r\n\r\n    # Výběr konstanty colormap podle zadaného řetězce\r\n    cmap_key = str(colormap_name).strip().upper()\r\n    selected_cmap = COLORMAP_DICT.get(cmap_key, cv2.COLORMAP_JET)\r\n\r\n    for item in heatmaps:\r\n        # Struktura prvků v heatmaps je n-tice: (heatmap_array, info_dict, index)\r\n        heatmap_array = None\r\n\r\n        if isinstance(item, (list, tuple)) and len(item) > 0:\r\n            heatmap_array = item[0]\r\n        elif isinstance(item, np.ndarray):\r\n            heatmap_array = item\r\n\r\n        if heatmap_array is None or not isinstance(heatmap_array, np.ndarray):\r\n            continue\r\n\r\n        # Ujistíme se, že jde o 2D pole\r\n        if heatmap_array.ndim > 2:\r\n            heatmap_array = np.squeeze(heatmap_array)\r\n\r\n        if heatmap_array.ndim != 2:\r\n            continue\r\n\r\n        # Normalizace dat do rozsahu 0 - 255 pro cv2.applyColorMap\r\n        min_val = np.min(heatmap_array)\r\n        max_val = np.max(heatmap_array)\r\n\r\n        if max_val > min_val:\r\n            normalized = (\r\n                (heatmap_array - min_val) / (max_val - min_val) * 255.0\r\n            ).astype(np.uint8)\r\n        else:\r\n            normalized = np.zeros_like(heatmap_array, dtype=np.uint8)\r\n\r\n        # Změna velikosti heatmapy na rozměry původního obrázku\r\n        if normalized.shape[0] != img_h or normalized.shape[1] != img_w:\r\n            resized_heatmap = cv2.resize(\r\n                normalized, (img_w, img_h), interpolation=cv2.INTER_CUBIC\r\n            )\r\n        else:\r\n            resized_heatmap = normalized\r\n\r\n        # Aplikace prahu (Threshold 0-100 %)\r\n        thresh_val = int(max(0.0, min(100.0, float(threshold_pct))) * 2.55)\r\n        mask = resized_heatmap >= thresh_val\r\n\r\n        if not np.any(mask):\r\n            continue  # Nic nepřekročilo práh\r\n\r\n        # Aplikace zvolené barevné palety\r\n        color_heatmap = cv2.applyColorMap(resized_heatmap, selected_cmap)\r\n\r\n        # Výpočet prolínání s alfa průhledností POUZE pro pixely nad prahem\r\n        alpha = max(0.0, min(1.0, float(alpha)))\r\n        blended = cv2.addWeighted(color_heatmap, alpha, result, 1.0 - alpha, 0)\r\n\r\n        # Do výsledku propíšeme zblendované pixely jen na místa, kde maska == True\r\n        result[mask] = blended[mask]\r\n\r\n    return result\r\n\r\n\r\ndef draw_detected_rectangles(\r\n    img, rects, fill=False, thickness=2, line_alpha=1.0, fill_alpha=0.3\r\n):\r\n    \"\"\"Vykreslí detekované obdélníky včetně textových štítků s názevem a confidence.\"\"\"\r\n    if not rects:\r\n        return img\r\n\r\n    img_h, img_w = img.shape[:2]\r\n\r\n    overlay_fill = img.copy()\r\n    overlay_line = img.copy()\r\n\r\n    has_fill = False\r\n    has_line = False\r\n\r\n    labels_to_draw = []\r\n\r\n    for item in rects:\r\n        if not isinstance(item, dict):\r\n            continue\r\n\r\n        # 1. Získání souřadnic\r\n        x = int(item.get(\"x\", 0))\r\n        y = int(item.get(\"y\", 0))\r\n        w = int(item.get(\"width\", 0))\r\n        h = int(item.get(\"height\", 0))\r\n\r\n        if w <= 0 or h <= 0:\r\n            continue\r\n\r\n        # 2. Extrakce barvy, násobení confidence a názvu\r\n        color = (0, 255, 0)\r\n        label_text = \"\"\r\n\r\n        class_names = item.get(\"classNames\", [])\r\n        if class_names and isinstance(class_names, list):\r\n            first_class = class_names[0]\r\n            if isinstance(first_class, dict):\r\n                if \"color\" in first_class:\r\n                    color = hex_to_bgr(first_class[\"color\"])\r\n\r\n                label = first_class.get(\"label\", \"\")\r\n                conf = first_class.get(\"confidence\", item.get(\"confidence\", None))\r\n\r\n                if label and conf is not None:\r\n                    label_text = f\"{label} ({int(round(conf * 100))}% )\"\r\n                elif label:\r\n                    label_text = label\r\n                elif conf is not None:\r\n                    label_text = f\"{int(round(conf * 100))}%\"\r\n\r\n        if not label_text and \"confidence\" in item:\r\n            label_text = f\"{int(round(item['confidence'] * 100))}%\"\r\n\r\n        pt1 = (x, y)\r\n        pt2 = (x + w, y + h)\r\n\r\n        # 3. Kreslení výplně obdélníku\r\n        if fill and fill_alpha > 0:\r\n            cv2.rectangle(overlay_fill, pt1, pt2, color, thickness=-1)\r\n            has_fill = True\r\n\r\n        # 4. Kreslení obrysu obdélníku\r\n        if thickness > 0 and line_alpha > 0:\r\n            cv2.rectangle(overlay_line, pt1, pt2, color, thickness=int(thickness))\r\n            has_line = True\r\n\r\n        if label_text:\r\n            labels_to_draw.append((x, y, w, h, label_text, color))\r\n\r\n    # Aplikace průhlednosti\r\n    result = img.copy()\r\n\r\n    if has_fill and fill_alpha > 0:\r\n        fill_alpha = max(0.0, min(1.0, float(fill_alpha)))\r\n        cv2.addWeighted(overlay_fill, fill_alpha, result, 1.0 - fill_alpha, 0, result)\r\n\r\n    if has_line and line_alpha > 0:\r\n        line_alpha = max(0.0, min(1.0, float(line_alpha)))\r\n        cv2.addWeighted(overlay_line, line_alpha, result, 1.0 - line_alpha, 0, result)\r\n\r\n    # 5. Vykreslení textových štítků navrch s inteligentním umísťováním\r\n    font = cv2.FONT_HERSHEY_SIMPLEX\r\n    font_scale = 0.5\r\n    font_thickness = 1\r\n\r\n    for rx, ry, rw, rh, text, bg_color in labels_to_draw:\r\n        (text_w, text_h), baseline = cv2.getTextSize(\r\n            text, font, font_scale, font_thickness\r\n        )\r\n\r\n        target_x = rx\r\n        target_y = ry - text_h - 6\r\n\r\n        if target_y < 0:\r\n            target_y = max(0, ry) + 2\r\n\r\n        target_x = max(5, target_x)\r\n        if target_x + text_w + 6 > img_w:\r\n            target_x = max(5, img_w - text_w - 10)\r\n\r\n        if target_y + text_h + 6 > img_h:\r\n            target_y = max(0, img_h - text_h - 10)\r\n\r\n        text_bg_pt1 = (int(target_x), int(target_y))\r\n        text_bg_pt2 = (int(target_x + text_w + 6), int(target_y + text_h + 6))\r\n        text_org = (int(target_x + 3), int(target_y + text_h + 3))\r\n\r\n        cv2.rectangle(result, text_bg_pt1, text_bg_pt2, bg_color, thickness=-1)\r\n\r\n        luminance = 0.299 * bg_color[2] + 0.587 * bg_color[1] + 0.114 * bg_color[0]\r\n        text_color = (0, 0, 0) if luminance > 128 else (255, 255, 255)\r\n\r\n        cv2.putText(\r\n            result,\r\n            text,\r\n            text_org,\r\n            font,\r\n            font_scale,\r\n            text_color,\r\n            font_thickness,\r\n            lineType=cv2.LINE_AA,\r\n        )\r\n\r\n    return result\r\n\r\n\r\ndef main(context, form):\r\n    # 1. Textové vstupy a dropdowny\r\n    save_path = str(\r\n        form.get(\"save_path\", r\"C:\\Users\\Michal Novák\\Desktop\\PMODULES\\LOGO\")\r\n    ).strip()\r\n    filename_format = str(\r\n        form.get(\"filename_format\", \"image_YYYY-MM-DD_HH-mm-ss\")\r\n    ).strip()\r\n    save_condition = str(form.get(\"save_condition\", \"ANY\")).strip().upper()\r\n    heatmap_colormap = str(form.get(\"heatmap_colormap\", \"JET\")).strip().upper()\r\n\r\n    # 2. Checkboxy (převod z UI na bool)\r\n    def parse_bool(val):\r\n        if isinstance(val, bool):\r\n            return val\r\n        return str(val).lower() in (\"true\", \"1\", \"yes\")\r\n\r\n    require_production_mode = parse_bool(form.get(\"require_production_mode\", False))\r\n    create_date_subfolder = parse_bool(form.get(\"create_date_subfolder\", False))\r\n    create_hour_subfolder = parse_bool(form.get(\"create_hour_subfolder\", False))\r\n    use_compression = parse_bool(form.get(\"use_compression\", False))\r\n    draw_rectangles = parse_bool(form.get(\"draw_rectangles\", False))\r\n    fill_rectangles = parse_bool(form.get(\"fill_rectangles\", False))\r\n    draw_heatmap = parse_bool(form.get(\"draw_heatmap\", False))\r\n\r\n    # 3. Číselné hodnoty\r\n    try:\r\n        compression_factor = int(form.get(\"compression_factor\", 3))\r\n    except (ValueError, TypeError):\r\n        compression_factor = 3\r\n\r\n    try:\r\n        line_thickness = int(form.get(\"line_thickness\", 2))\r\n    except (ValueError, TypeError):\r\n        line_thickness = 2\r\n\r\n    try:\r\n        line_alpha = float(form.get(\"line_alpha\", 1.0))\r\n    except (ValueError, TypeError):\r\n        line_alpha = 1.0\r\n\r\n    try:\r\n        fill_alpha = float(form.get(\"fill_alpha\", 0.3))\r\n    except (ValueError, TypeError):\r\n        fill_alpha = 0.3\r\n\r\n    try:\r\n        heatmap_alpha = float(form.get(\"heatmap_alpha\", 0.5))\r\n    except (ValueError, TypeError):\r\n        heatmap_alpha = 0.5\r\n\r\n    try:\r\n        heatmap_threshold = float(form.get(\"heatmap_threshold\", 20.0))\r\n    except (ValueError, TypeError):\r\n        heatmap_threshold = 20.0\r\n\r\n    # Spuštění ukládací logiky\r\n    ukladator(\r\n        context=context,\r\n        save_path=save_path,\r\n        filename_format=filename_format,\r\n        save_condition=save_condition,\r\n        require_production_mode=require_production_mode,\r\n        create_date_subfolder=create_date_subfolder,\r\n        create_hour_subfolder=create_hour_subfolder,\r\n        use_compression=use_compression,\r\n        compression_factor=compression_factor,\r\n        draw_rectangles=draw_rectangles,\r\n        fill_rectangles=fill_rectangles,\r\n        line_thickness=line_thickness,\r\n        line_alpha=line_alpha,\r\n        fill_alpha=fill_alpha,\r\n        draw_heatmap=draw_heatmap,\r\n        heatmap_alpha=heatmap_alpha,\r\n        heatmap_threshold=heatmap_threshold,\r\n        heatmap_colormap=heatmap_colormap,\r\n    )\r\n\r\n\r\ndef ukladator(\r\n    context,\r\n    save_path=r\"C:\\Users\\Michal Novák\\Desktop\\PMODULES\\LOGO\",\r\n    filename_format=\"image_YYYY-MM-DD_HH-mm-ss\",\r\n    file_extension=\".png\",\r\n    save_condition=\"ANY\",\r\n    require_production_mode=False,\r\n    create_date_subfolder=False,\r\n    create_hour_subfolder=False,\r\n    use_compression=False,\r\n    compression_factor=3,\r\n    draw_rectangles=False,\r\n    fill_rectangles=False,\r\n    line_thickness=2,\r\n    line_alpha=1.0,\r\n    fill_alpha=0.3,\r\n    draw_heatmap=False,\r\n    heatmap_alpha=0.5,\r\n    heatmap_threshold=20.0,\r\n    heatmap_colormap=\"JET\",\r\n):\r\n    # --- A. KONTROLA VSTUPNÍHO OBRÁZKU ---\r\n    if \"image\" not in context or context[\"image\"] is None:\r\n        print(\"[Ukladator ERROR] V context['image'] NENÍ žádný obrázek!\")\r\n        return\r\n\r\n    # Pracujeme s kopií obrázku\r\n    img_to_save = context[\"image\"].copy()\r\n\r\n    # --- B. KONTROLA PRODUCTION MODE ---\r\n    if require_production_mode:\r\n        is_prod = bool(context.get(\"production_mode\", False))\r\n        if not is_prod:\r\n            print(\"[Ukladator SKIP] Vynecháno: Vyžadován Production Mode, ale v context.production_mode není True.\")\r\n            return\r\n\r\n    # --- C. FILTROVÁNÍ PODLE CONTEXT.RESULT ---\r\n    result_val = bool(context.get(\"result\", False))\r\n\r\n    if save_condition == \"TRUE\" and not result_val:\r\n        print(f\"[Ukladator SKIP] Vynecháno: result je False, nastaveno 'True'.\")\r\n        return\r\n    elif save_condition == \"FALSE\" and result_val:\r\n        print(f\"[Ukladator SKIP] Vynecháno: result je True, nastaveno 'False'.\")\r\n        return\r\n\r\n    # --- D. VYKRESLENÍ HEATMAPY ---\r\n    if draw_heatmap:\r\n        heatmaps = context.get(\"heatmaps\", [])\r\n        if heatmaps:\r\n            img_to_save = draw_heatmaps(\r\n                img=img_to_save,\r\n                heatmaps=heatmaps,\r\n                alpha=heatmap_alpha,\r\n                threshold_pct=heatmap_threshold,\r\n                colormap_name=heatmap_colormap,\r\n            )\r\n\r\n    # --- E. VYKRESLENÍ DETECTED RECTANGLES ---\r\n    if draw_rectangles:\r\n        detected_rects = context.get(\"detectedRectangles\", [])\r\n        if detected_rects:\r\n            img_to_save = draw_detected_rectangles(\r\n                img=img_to_save,\r\n                rects=detected_rects,\r\n                fill=fill_rectangles,\r\n                thickness=line_thickness,\r\n                line_alpha=line_alpha,\r\n                fill_alpha=fill_alpha,\r\n            )\r\n\r\n    # --- F. SESTAVENÍ DYNAMICKÉ CESTY A PODSLOŽEK ---\r\n    now = datetime.now()\r\n    final_target_path = save_path\r\n\r\n    if create_date_subfolder:\r\n        date_folder = now.strftime(\"%Y-%m-%d\")\r\n        final_target_path = os.path.join(final_target_path, date_folder)\r\n\r\n        if create_hour_subfolder:\r\n            hour_folder = now.strftime(\"%H\")\r\n            final_target_path = os.path.join(final_target_path, hour_folder)\r\n\r\n    if not os.path.exists(final_target_path):\r\n        try:\r\n            os.makedirs(final_target_path, exist_ok=True)\r\n            print(f\"[Ukladator] Složka vytvořena: {final_target_path}\")\r\n        except Exception as e:\r\n            print(f\"[Ukladator ERROR] Nelze vytvořit složku {final_target_path}: {e}\")\r\n            return\r\n\r\n    # --- G. FORMÁTOVÁNÍ NÁZVU SOUBORU ---\r\n    fmt = filename_format\r\n\r\n    if \"%\" not in fmt:\r\n        fmt = (\r\n            fmt.replace(\"YYYY\", \"%Y\")\r\n            .replace(\"YY\", \"%y\")\r\n            .replace(\"MM\", \"%m\")\r\n            .replace(\"DD\", \"%d\")\r\n            .replace(\"HH\", \"%H\")\r\n            .replace(\"mm\", \"%M\")\r\n            .replace(\"ss\", \"%S\")\r\n        )\r\n\r\n    try:\r\n        filename_base = now.strftime(fmt)\r\n    except Exception:\r\n        filename_base = now.strftime(\"image_%Y-%m-%d_%H-%M-%S\")\r\n\r\n    if not file_extension.startswith(\".\"):\r\n        file_extension = \".\" + file_extension\r\n\r\n    full_filename = f\"{filename_base}{file_extension}\"\r\n    full_path = os.path.join(final_target_path, full_filename)\r\n\r\n    # Ošetření duplicity\r\n    counter = 1\r\n    file_root, ext = os.path.splitext(full_path)\r\n    while os.path.exists(full_path):\r\n        full_path = f\"{file_root}_{counter}{ext}\"\r\n        counter += 1\r\n\r\n    # --- H. NASTAVENÍ PARAMETRŮ KOMPRESE ---\r\n    encode_params = []\r\n    ext_lower = ext.lower()\r\n\r\n    if ext_lower == \".png\":\r\n        if use_compression:\r\n            comp_val = max(0, min(9, int(compression_factor)))\r\n            encode_params = [cv2.IMWRITE_PNG_COMPRESSION, comp_val]\r\n        else:\r\n            encode_params = [cv2.IMWRITE_PNG_COMPRESSION, 0]\r\n\r\n    elif ext_lower in (\".jpg\", \".jpeg\"):\r\n        if use_compression:\r\n            quality_val = max(0, min(100, int(compression_factor)))\r\n            encode_params = [cv2.IMWRITE_JPEG_QUALITY, quality_val]\r\n        else:\r\n            encode_params = [cv2.IMWRITE_JPEG_QUALITY, 95]\r\n\r\n    # --- I. BEZPEČNÉ ULOŽENÍ PŘES IMENCODE ---\r\n    try:\r\n        ext_for_encode = os.path.splitext(full_path)[1]\r\n        success, encoded_img = cv2.imencode(ext_for_encode, img_to_save, encode_params)\r\n\r\n        if success:\r\n            encoded_img.tofile(full_path)\r\n            print(f\"[Ukladator SUCCESS] Obrázek uložen: {full_path}\")\r\n        else:\r\n            print(f\"[Ukladator ERROR] cv2.imencode selhalo při kódování.\")\r\n    except Exception as e:\r\n        print(f\"[Ukladator EXCEPTION] Chyba při zápisu: {e}\")","form":[{"id":1790159136988,"type":"text","label":"Cesta ke složce","formKey":"save_path","defaultValue":"./output","visibility":""},{"id":1790159186302,"type":"text","label":"Formát názvu souboru","formKey":"filename_format","defaultValue":"image_YYYY-MM-DD_HH-mm-ss","visibility":""},{"id":1790159210938,"type":"select","label":"Ukládat snímky","formKey":"save_condition","defaultValue":"ANY","options":"True;False;ANY","visibility":""},{"id":1790159791850,"type":"checkbox","label":"Production mode (vyhodnocuje pouze v runu)","formKey":"require_production_mode","defaultValue":true,"visibility":""},{"id":1790160147183,"type":"checkbox","label":"Podsložka s datem (YYYY-MM-DD)","formKey":"create_date_subfolder","defaultValue":false,"visibility":""},{"id":1790160147655,"type":"checkbox","label":"Podsložka s hodinou (HH)","formKey":"create_hour_subfolder","defaultValue":false,"visibility":"create_date_subfolder"},{"id":1790160456131,"type":"checkbox","label":"Komprimovat","formKey":"use_compression","defaultValue":false,"visibility":""},{"id":1790160480116,"type":"number","label":"kompresni koeficient 0-9","formKey":"compression_factor","min":0,"max":9,"defaultValue":0,"visibility":"use_compression"},{"id":1790161495652,"type":"checkbox","label":"Vykreslit detectedRectangles","formKey":"draw_rectangles","defaultValue":false,"visibility":""},{"id":1790161518924,"type":"checkbox","label":"Kreslit výplň (Fill)","formKey":"fill_rectangles","defaultValue":false,"visibility":"draw_rectangles"},{"id":1790161540232,"type":"number","label":"Tloušťka čáry (Thickness)","formKey":"line_thickness","min":1,"max":50,"defaultValue":"2","visibility":"draw_rectangles"},{"id":1790161620429,"type":"number","label":"Průhlednost čáry (Line Alpha)","formKey":"line_alpha","min":0,"max":1,"defaultValue":"0.7","visibility":"draw_rectangles"},{"id":1790161667966,"type":"number","label":"Průhlednost výplně (Fill Alpha)","formKey":"fill_alpha","min":0,"max":1,"defaultValue":"0.2","visibility":"fill_rectangles"},{"id":1790165827007,"type":"checkbox","label":"Vykreslit heatmapu","formKey":"draw_heatmap","defaultValue":false,"visibility":""},{"id":1790165852230,"type":"number","label":"Průhlednost heatmapy (alpha)","formKey":"heatmap_alpha","min":0,"max":1,"defaultValue":"0.5","visibility":"draw_heatmap"},{"id":1790166074346,"type":"number","label":"Treshold heatmapy","formKey":"heatmap_threshold","min":0,"max":100,"defaultValue":"0","visibility":"draw_heatmap"},{"id":1790166503538,"type":"select","label":"Colormap","formKey":"heatmap_colormap","defaultValue":"JET","options":"JET;HOT;TURBO;VIRIDIS;INFERNO;MAGMA;PLASMA;RAINBOW;HSV","visibility":"draw_heatmap"}],"formValues":{"save_path":"C:\\Users\\Michal Novák\\Desktop\\PMODULES\\LOGO","filename_format":"NoK_YYYY-MM-DD_HH-mm-ss","save_condition":"ANY","require_production_mode":true,"create_date_subfolder":false,"create_hour_subfolder":true,"use_compression":false,"compression_factor":9,"draw_rectangles":false,"fill_rectangles":false,"line_thickness":2,"line_alpha":0.7,"fill_alpha":0.2,"draw_heatmap":true,"heatmap_alpha":0.3,"heatmap_threshold":80,"heatmap_colormap":"PLASMA"},"showImagePreview":true,"editDate":1790169672159,"isActive":false},"version":"4.0.3"}