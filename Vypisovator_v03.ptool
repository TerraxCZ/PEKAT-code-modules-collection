{
    "type": "CODE",
    "module": {
        "label": "Vypisovator_v03",
        "id": 28,
        "note": "Python modul pro PEKAT Vision určený k vykreslování uživatelského textu, časového razítka a průhledného vodoznaku přímo do snímku.          \n------------------------------------------------\nA PEKAT Vision Python module designed to render custom text, timestamp, and a transparent watermark overlay onto the image.",
        "gpuSettings": [],
        "softDeletedDate": null,
        "type": "CODE",
        "sourceCode": "import base64\r\nfrom datetime import datetime\r\nimport cv2\r\nimport numpy as np\r\n\r\n# Sem vložte váš Base64 řetězec obrázku (např. LOGO_Fablab.png)\r\nHARDCODED_LOGO_B64 = \"\"\"\r\\r\n\"\"\"\r\n\r\n# Společný slovník barev pro text i jeho podbarvení (BGR formát)\r\nQUICK_COLOURS = {\r\n    \"Červená\": [0, 0, 255],\r\n    \"Zelená\": [0, 255, 0],\r\n    \"Modrá\": [255, 0, 0],\r\n    \"Akvamarínová (Cyan)\": [255, 255, 0],\r\n    \"Fialová (Magenta)\": [255, 0, 255],\r\n    \"Žlutá\": [0, 255, 255],\r\n    \"Černá\": [0, 0, 0],\r\n    \"Bílá\": [255, 255, 255],\r\n    \"Electric\": [174, 250, 120],\r\n    \"Emerald\": [47, 58, 14],\r\n}\r\n\r\n\r\ndef hex_or_name_to_bgr(val, default=(0, 0, 0)):\r\n    \"\"\"Převede název barvy, HEX řetězec nebo n-tici na BGR hodnotu pro OpenCV.\"\"\"\r\n    if isinstance(val, (list, tuple)) and len(val) == 3:\r\n        return tuple(val)\r\n\r\n    val_str = str(val).strip()\r\n\r\n    # 1. Kontrola z předdefinovaných názvů\r\n    if val_str in QUICK_COLOURS:\r\n        return tuple(QUICK_COLOURS[val_str])\r\n\r\n    # 2. Kontrola HEX formátu (#RRGGBB)\r\n    clean_hex = val_str.lstrip(\"#\")\r\n    if len(clean_hex) == 6:\r\n        try:\r\n            r = int(clean_hex[0:2], 16)\r\n            g = int(clean_hex[2:4], 16)\r\n            b = int(clean_hex[4:6], 16)\r\n            return (b, g, r)\r\n        except ValueError:\r\n            pass\r\n\r\n    return default\r\n\r\n\r\ndef main(context, form):\r\n    # --- Textové nastavení ---\r\n    draw_text = form.get(\"draw_text\", True)\r\n    if isinstance(draw_text, str):\r\n        draw_text = draw_text.lower() in (\"true\", \"1\", \"yes\")\r\n\r\n    custom_text = str(form.get(\"custom_text\", \"Pekat Vision\")) if draw_text else \"\"\r\n\r\n    draw_datetime = form.get(\"draw_datetime\", True)\r\n    if isinstance(draw_datetime, str):\r\n        draw_datetime = draw_datetime.lower() in (\"true\", \"1\", \"yes\")\r\n\r\n    datetime_format = (\r\n        str(form.get(\"datetime_format\", \"%Y-%m-%d %H:%M:%S\"))\r\n        if draw_datetime\r\n        else \"\"\r\n    )\r\n\r\n    corner_form = str(form.get(\"corner_form\", \"Pravý horní\"))\r\n    colour_form = str(form.get(\"colour_form\", \"Zelená\"))\r\n    scale_form = float(form.get(\"scale_form\", 1.0))\r\n    thickness_form = int(form.get(\"thickness_form\", 2))\r\n    offset_x_form = int(form.get(\"offset_x_form\", 20))\r\n    offset_y_form = int(form.get(\"offset_y_form\", 30))\r\n\r\n    # --- Podbarvení textu ---\r\n    highlight_text = form.get(\"highlight_text\", False)\r\n    if isinstance(highlight_text, str):\r\n        highlight_text = highlight_text.lower() in (\"true\", \"1\", \"yes\")\r\n\r\n    text_bg_alpha = float(form.get(\"text_bg_alpha\", 0.5))\r\n    text_bg_colour = str(form.get(\"text_bg_colour\", \"Černá\"))\r\n\r\n    # --- Vodoznak nastavení ---\r\n    draw_watermark = form.get(\"draw_watermark\", True)\r\n    if isinstance(draw_watermark, str):\r\n        draw_watermark = draw_watermark.lower() in (\"true\", \"1\", \"yes\")\r\n\r\n    wm_corner = str(form.get(\"wm_corner\", \"Pravý dolní\"))\r\n    wm_scale = float(form.get(\"wm_scale\", 0.5))\r\n    wm_alpha = float(form.get(\"wm_alpha\", 0.7))\r\n    wm_offset_x = int(form.get(\"wm_offset_x\", 20))\r\n    wm_offset_y = int(form.get(\"wm_offset_y\", 20))\r\n\r\n    # --- Podbarvit vodoznak ---\r\n    highlight_watermark = form.get(\"highlight_watermark\", False)\r\n    if isinstance(highlight_watermark, str):\r\n        highlight_watermark = highlight_watermark.lower() in (\"true\", \"1\", \"yes\")\r\n\r\n    # Dynamické řádky z kódu\r\n    extra_lines = [\r\n        # f\"Počet OK: {context.get('ok_count', 0)}\",\r\n    ]\r\n\r\n    vypisovator(\r\n        context=context,\r\n        text=custom_text,\r\n        datetime_format=datetime_format,\r\n        corner=corner_form,\r\n        colour=colour_form,\r\n        scale=scale_form,\r\n        thickness=thickness_form,\r\n        offset_x=offset_x_form,\r\n        offset_y=offset_y_form,\r\n        extra_lines=extra_lines,\r\n        # Podbarvení textu\r\n        highlight_text=highlight_text,\r\n        text_bg_alpha=text_bg_alpha,\r\n        text_bg_colour=text_bg_colour,\r\n        # Vodoznak\r\n        draw_watermark=draw_watermark,\r\n        wm_corner=wm_corner,\r\n        wm_scale=wm_scale,\r\n        wm_alpha=wm_alpha,\r\n        wm_offset_x=wm_offset_x,\r\n        wm_offset_y=wm_offset_y,\r\n        # Podbarvení vodoznaku\r\n        highlight_watermark=highlight_watermark,\r\n    )\r\n\r\n\r\ndef get_watermark_bbox(img_shape, wm_shape, corner, scale, offset_x, offset_y):\r\n    \"\"\"Pomocná funkce pro výpočet přesných souřadnic umístění vodoznaku na obrázku.\"\"\"\r\n    h_img, w_img = img_shape[:2]\r\n    h_wm, w_wm = wm_shape[:2]\r\n\r\n    if scale > 0 and scale != 1.0:\r\n        wm_w = max(1, int(w_wm * scale))\r\n        wm_h = max(1, int(h_wm * scale))\r\n    else:\r\n        wm_w, wm_h = w_wm, h_wm\r\n\r\n    corner_lower = str(corner).lower()\r\n    is_left = \"levý\" in corner_lower or \"left\" in corner_lower\r\n    is_top = \"horní\" in corner_lower or \"top\" in corner_lower\r\n\r\n    x = offset_x if is_left else (w_img - wm_w - offset_x)\r\n    y = offset_y if is_top else (h_img - wm_h - offset_y)\r\n\r\n    x1, y1 = max(0, int(x)), max(0, int(y))\r\n    x2, y2 = min(w_img, int(x + wm_w)), min(h_img, int(y + wm_h))\r\n\r\n    return x1, y1, x2, y2\r\n\r\n\r\ndef vypisovator(\r\n    context,\r\n    text=\"\",\r\n    datetime_format=\"\",\r\n    corner=\"Pravý horní\",\r\n    colour=\"Zelená\",\r\n    scale=1.0,\r\n    thickness=2,\r\n    offset_x=20,\r\n    offset_y=30,\r\n    extra_lines=None,\r\n    # Podbarvení textu\r\n    highlight_text=False,\r\n    text_bg_alpha=0.5,\r\n    text_bg_colour=\"Černá\",\r\n    # Vodoznak\r\n    draw_watermark=False,\r\n    wm_corner=\"Pravý dolní\",\r\n    wm_scale=0.5,\r\n    wm_alpha=0.7,\r\n    wm_offset_x=20,\r\n    wm_offset_y=20,\r\n    highlight_watermark=False,\r\n):\r\n    if \"image\" not in context or context[\"image\"] is None:\r\n        return\r\n\r\n    image = context[\"image\"]\r\n    h, w = image.shape[:2]\r\n\r\n    # Načtení dekódovaného vodoznaku\r\n    wm_img = None\r\n    if draw_watermark and HARDCODED_LOGO_B64.strip():\r\n        try:\r\n            nparr = np.frombuffer(\r\n                base64.b64decode(HARDCODED_LOGO_B64.strip()), np.uint8\r\n            )\r\n            wm_img = cv2.imdecode(nparr, cv2.IMREAD_UNCHANGED)\r\n        except Exception:\r\n            pass\r\n\r\n    # -------------------------------------------------------------------------\r\n    # 1. SPODNÍ VRSTVA: PODBARVENÍ VODOZNAKU\r\n    # -------------------------------------------------------------------------\r\n    if highlight_watermark and wm_img is not None:\r\n        rx1, ry1, rx2, ry2 = get_watermark_bbox(\r\n            image.shape,\r\n            wm_img.shape,\r\n            wm_corner,\r\n            wm_scale,\r\n            wm_offset_x,\r\n            wm_offset_y,\r\n        )\r\n\r\n        pad_x, pad_y = 5, 5\r\n        rx1 = max(0, rx1 - pad_x)\r\n        ry1 = max(0, ry1 - pad_y)\r\n        rx2 = min(w, rx2 + pad_x)\r\n        ry2 = min(h, ry2 + pad_y)\r\n\r\n        if rx1 < rx2 and ry1 < ry2:\r\n            rect_overlay = image[ry1:ry2, rx1:rx2].copy()\r\n            rect_color_bgr = (174, 250, 120)  # HEX #78faae\r\n\r\n            cv2.rectangle(\r\n                rect_overlay, (0, 0), (rx2 - rx1, ry2 - ry1), rect_color_bgr, -1\r\n            )\r\n\r\n            alpha_val = max(0.0, min(1.0, float(wm_alpha)))\r\n            blended_rect = cv2.addWeighted(\r\n                image[ry1:ry2, rx1:rx2],\r\n                1.0 - alpha_val,\r\n                rect_overlay,\r\n                alpha_val,\r\n                0,\r\n            )\r\n            image[ry1:ry2, rx1:rx2] = blended_rect\r\n\r\n    # -------------------------------------------------------------------------\r\n    # 2. HORNÍ VRSTVA: VODOZNAK\r\n    # -------------------------------------------------------------------------\r\n    if wm_img is not None:\r\n        apply_watermark(\r\n            image=image,\r\n            watermark=wm_img,\r\n            corner=wm_corner,\r\n            scale=wm_scale,\r\n            alpha=wm_alpha,\r\n            offset_x=wm_offset_x,\r\n            offset_y=wm_offset_y,\r\n        )\r\n\r\n    # -------------------------------------------------------------------------\r\n    # 3. PŘÍPRAVA ŘÁDKŮ TEXTU\r\n    # -------------------------------------------------------------------------\r\n    lines = []\r\n    if text:\r\n        lines.append(text)\r\n\r\n    if datetime_format:\r\n        now = datetime.now()\r\n        try:\r\n            fmt = datetime_format\r\n            if \"%\" not in fmt:\r\n                fmt = (\r\n                    fmt.replace(\"YYYY\", \"%Y\")\r\n                    .replace(\"YY\", \"%y\")\r\n                    .replace(\"MM\", \"%m\")\r\n                    .replace(\"DD\", \"%d\")\r\n                    .replace(\"HH\", \"%H\")\r\n                    .replace(\"mm\", \"%M\")\r\n                    .replace(\"ss\", \"%S\")\r\n                )\r\n            lines.append(now.strftime(fmt))\r\n        except Exception:\r\n            lines.append(now.strftime(\"%Y-%m-%d %H:%M:%S\"))\r\n\r\n    if extra_lines:\r\n        for line in extra_lines:\r\n            if line:\r\n                lines.append(str(line))\r\n\r\n    # -------------------------------------------------------------------------\r\n    # 4. PODBARVENÍ TEXTU A VYKRESLENÍ TEXTŮ\r\n    # -------------------------------------------------------------------------\r\n    if lines:\r\n        font = cv2.FONT_HERSHEY_SIMPLEX\r\n        text_bgr = hex_or_name_to_bgr(colour, default=(0, 255, 0))\r\n\r\n        (sample_w, sample_h), baseline = cv2.getTextSize(\r\n            \"Ay\", font, scale, thickness\r\n        )\r\n        line_height = int((sample_h + baseline) * 1.5)\r\n        total_lines = len(lines)\r\n\r\n        corner_lower = str(corner).lower()\r\n        is_left = \"levý\" in corner_lower or \"left\" in corner_lower\r\n        is_top = \"horní\" in corner_lower or \"top\" in corner_lower\r\n\r\n        # Vypočítáme pozice (x, y) a šířky pro všechny řádky\r\n        line_data = []\r\n        max_line_w = 0\r\n\r\n        for idx, line_str in enumerate(lines):\r\n            (text_w, text_h), _ = cv2.getTextSize(\r\n                line_str, font, scale, thickness\r\n            )\r\n            if text_w > max_line_w:\r\n                max_line_w = text_w\r\n\r\n            x = offset_x if is_left else w - text_w - offset_x\r\n            y = (\r\n                offset_y + (idx + 1) * line_height\r\n                if is_top\r\n                else h - offset_y - (total_lines - 1 - idx) * line_height\r\n            )\r\n\r\n            line_data.append(\r\n                {\r\n                    \"text\": line_str,\r\n                    \"x\": int(x),\r\n                    \"y\": int(y),\r\n                    \"w\": text_w,\r\n                    \"h\": text_h,\r\n                }\r\n            )\r\n\r\n        # --- A. PODBARVENÍ TEXTU (PODKLADOVÝ OBDÉLNÍK) ---\r\n        if highlight_text and text_bg_alpha > 0:\r\n            bg_bgr = hex_or_name_to_bgr(text_bg_colour, default=(0, 0, 0))\r\n            pad_x, pad_y = 8, 6\r\n\r\n            # Výpočet celkového hraničního obdélníku pro všechny řádky textu\r\n            if is_left:\r\n                tx1 = offset_x - pad_x\r\n                tx2 = offset_x + max_line_w + pad_x\r\n            else:\r\n                tx1 = w - offset_x - max_line_w - pad_x\r\n                tx2 = w - offset_x + pad_x\r\n\r\n            min_y = min(item[\"y\"] - item[\"h\"] for item in line_data) - pad_y\r\n            max_y = max(item[\"y\"] for item in line_data) + baseline + pad_y\r\n\r\n            bx1, by1 = max(0, int(tx1)), max(0, int(min_y))\r\n            bx2, by2 = min(w, int(tx2)), min(h, int(max_y))\r\n\r\n            if bx1 < bx2 and by1 < by2:\r\n                crop = image[by1:by2, bx1:bx2].copy()\r\n                rect_overlay = crop.copy()\r\n                cv2.rectangle(\r\n                    rect_overlay,\r\n                    (0, 0),\r\n                    (bx2 - bx1, by2 - by1),\r\n                    bg_bgr,\r\n                    thickness=-1,\r\n                )\r\n\r\n                bg_alpha_val = max(0.0, min(1.0, float(text_bg_alpha)))\r\n                blended_text_bg = cv2.addWeighted(\r\n                    crop, 1.0 - bg_alpha_val, rect_overlay, bg_alpha_val, 0\r\n                )\r\n                image[by1:by2, bx1:bx2] = blended_text_bg\r\n\r\n        # --- B. SAMOTNÉ VYKRESLENÍ TEXTU ---\r\n        for item in line_data:\r\n            cv2.putText(\r\n                image,\r\n                item[\"text\"],\r\n                (item[\"x\"], item[\"y\"]),\r\n                font,\r\n                scale,\r\n                text_bgr,\r\n                thickness,\r\n                cv2.LINE_AA,\r\n            )\r\n\r\n    context[\"image\"] = image\r\n\r\n\r\ndef apply_watermark(image, watermark, corner, scale, alpha, offset_x, offset_y):\r\n    h_img, w_img = image.shape[:2]\r\n    h_wm, w_wm = watermark.shape[:2]\r\n\r\n    # Úprava velikosti vodoznaku\r\n    if scale > 0 and scale != 1.0:\r\n        new_w = max(1, int(w_wm * scale))\r\n        new_h = max(1, int(h_wm * scale))\r\n        wm_resized = cv2.resize(\r\n            watermark, (new_w, new_h), interpolation=cv2.INTER_AREA\r\n        )\r\n    else:\r\n        wm_resized = watermark\r\n\r\n    wm_h, wm_w = wm_resized.shape[:2]\r\n\r\n    # Pozicování podle rohu\r\n    corner_lower = str(corner).lower()\r\n    is_left = \"levý\" in corner_lower or \"left\" in corner_lower\r\n    is_top = \"horní\" in corner_lower or \"top\" in corner_lower\r\n\r\n    x = offset_x if is_left else (w_img - wm_w - offset_x)\r\n    y = offset_y if is_top else (h_img - wm_h - offset_y)\r\n\r\n    x, y = int(x), int(y)\r\n\r\n    # Ořez přetečení přes okraj snímku\r\n    x1, y1 = max(0, x), max(0, y)\r\n    x2, y2 = min(w_img, x + wm_w), min(h_img, y + wm_h)\r\n\r\n    if x1 >= x2 or y1 >= y2:\r\n        return\r\n\r\n    wm_x1 = x1 - x\r\n    wm_y1 = y1 - y\r\n    wm_x2 = wm_x1 + (x2 - x1)\r\n    wm_y2 = wm_y1 + (y2 - y1)\r\n\r\n    wm_crop = wm_resized[wm_y1:wm_y2, wm_x1:wm_x2]\r\n    img_crop = image[y1:y2, x1:x2]\r\n\r\n    alpha = max(0.0, min(1.0, float(alpha)))\r\n\r\n    # Mísení obrázků s ohledem na průhlednost (RGBA vs BGR)\r\n    if wm_crop.shape[2] == 4:\r\n        wm_rgb = wm_crop[:, :, :3]\r\n        wm_a = (wm_crop[:, :, 3] / 255.0) * alpha\r\n        wm_a = np.expand_dims(wm_a, axis=-1)\r\n\r\n        blended = img_crop.astype(float) * (1.0 - wm_a) + wm_rgb.astype(\r\n            float\r\n        ) * wm_a\r\n        image[y1:y2, x1:x2] = blended.astype(np.uint8)\r\n    else:\r\n        blended = cv2.addWeighted(img_crop, 1.0 - alpha, wm_crop, alpha, 0)\r\n        image[y1:y2, x1:x2] = blended",
        "form": [
