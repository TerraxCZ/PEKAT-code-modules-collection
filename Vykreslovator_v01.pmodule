{"type":"CODE","module":{"label":"Vykreslovator_v01","id":4,"type":"CODE","note":"","gpuSettings":[],"softDeletedDate":null,"sourceCode":"import cv2\nimport skimage\nimport numpy as np\nfrom pekat_communication import PEKAT\n\n\ndef main(context, form):\n    POS_form = int(form[\"POS_form\"])\n    MAX_form = int(form[\"MAX_form\"])\n    colour_form = int(form[\"colour_form\"])\n    size_form = int(form[\"size_form\"])\n    offset_form = int(form[\"offset_form\"])\n    \n    translator_dict = {0: \"r\", 1: \"g\", 2: \"b\", 3: \"c\", 4: \"m\", 5: \"y\", 6: \"k\", 7: \"w\", }\n    \n    colour_translated = translator_dict[colour_form]\n    \n    vykreslovator(context, POS_form, MAX_form, colour_translated, size_form, offset_form)\n    \n    #vykreslovator(context, colour = \"m\", POS=0, MAX=2, size=20, offset=50)\n    #print(f\"POS_form: {POS_form}, MAX_form: {MAX_form}, colour_form: {colour_translated}, size_form: {size_form}, offset_form: {offset_form}, \")\n    \ndef vykreslovator(context, POS: int = 0, MAX: int = 2, colour: list = [255, 0, 0], size: int = 20, offset: int = 50) -> None:\n    '''\n    Plots a square in the image for PEKAT diagnostic purpouses.\n    \n    context:    must be provided to function properly due to PEKAT\n    POS, MAX:   describes the location of the square \"POS out of MAX\", so POS=1, MAX=2 draws it in the middle, POS=2, MAX=2 draws it at the bottom (indexing starts with 0)\n    colour:     specifies the colour of the square be either RGB 0-255 value in list/tuple (red = [255, 0, 0]), or quick colour string (red = \"r\") ; (quick colours: {\"r\",\"g\",\"b\",\"c\",\"m\",\"y\",\"k\",\"w\"})\n    size:       specifies the length of the edge of the square in pixels\n    offset:     specifies offset in pixels from the left image edge\n    '''\n    quick_colours = {\"r\": [255, 0, 0], \"g\": [0, 255, 0], \"b\": [0, 0, 255], \"c\": [0, 255, 255], \"m\": [255, 0, 255], \"y\": [255, 255, 0], \"k\": [0, 0, 0], \"w\": [255, 255, 255]}   # Short names and their values for quick colours\n    \n    # ------------------------------------- # INPUT VALIDATION # -------------------------------------\n    # POS validation\n    if not isinstance(POS,int):\n        raise TypeError(f\"POS must be an integer number greater than 0 and smaller than argument MAX. Given: {type(POS).__name__}\")\n    \n    if isinstance(POS, int):\n        if POS < 0:\n            raise ValueError(f\"POS must be an integer number greater than 0 and smaller than argument MAX. Given: {type(POS).__name__}: {POS} (Value must be > 0)\")\n        if POS > MAX:\n            raise ValueError(f\"POS must be an integer number greater than 0 and smaller than argument MAX. Given: {type(POS).__name__}: {POS} (Value must <= {MAX})\")\n    \n    # MAX validation\n    if not isinstance(MAX,int):\n        raise TypeError(f\"MAX must be an integer number greater than 0 and smaller than argument MAX. Given: {type(POS).__name__}\")\n    \n    if isinstance(MAX, int):\n         if POS < 0:\n            raise ValueError(f\"MAX must be an integer number greater than 0. Given: {type(POS).__name__}: {POS} (Value must be > 0)\")\n    \n    # Colour validation\n    if not isinstance(colour, (list, tuple, str)):\n        raise TypeError(f\"Colour must be an RGB list/tuple of ints 0-255, or string with one of the quick colour names: {set(quick_colours.keys())}. Given: {type(colour).__name__}\")\n    \n    if isinstance(colour, (tuple, list)):\n        if len(colour) != 3:\n            raise ValueError(f\"Colour must be an RGB list/tuple of ints 0-255, or string with one of the quick colour names: {quick_colours}. Given: {type(colour).__name__}, length: {len(colour)}\")\n    \n    if isinstance(colour, str):\n        if colour not in quick_colours:\n            raise ValueError(f\"Colour must be an RGB list/tuple of ints 0-255, or string with one of the quick colour names: {set(quick_colours.keys())}. Given: {type(colour).__name__}: {colour} ({colour} is not a quick colour)\")\n            \n    # size validation\n    if not isinstance(size,int):\n        raise TypeError(f\"size must be an integer number greater than 0 and smaller than argument MAX. Given: {type(size).__name__}\")\n    \n    if isinstance(size, int):\n         if size < 1:\n            raise ValueError(f\"size must be an integer number greater than 0. Given: {type(size).__name__}: {size} (Value must be > 0)\")\n            \n    # offset validation\n    if not isinstance(offset,int):\n        raise TypeError(f\"offset must be an integer number greater than 0 and smaller than argument MAX. Given: {type(offset).__name__}\")\n    \n    if isinstance(offset, int):\n         if offset < 1:\n            raise ValueError(f\"offset must be an integer number greater than 0. Given: {type(offset).__name__}: {offset} (Value must be > 0)\")\n        \n    # ----------------------------------- # RECTANGLE DIMENSIONS # -----------------------------------\n    \n    if isinstance(colour, str):\n        colour = quick_colours[colour]  # Transform RGB value into BGR\n    \n    image = context[\"image\"]\n    h, w = image.shape[:2]\n    colour_bgr = colour[::-1]   # Conversion to shitass brg\n    \n    segment_height = round(h/(MAX + 1))    # Height of one segment\n    segment_middle = round(segment_height/2)\n    x_pos = w - offset\n    y_pos = segment_middle + (POS * segment_height)\n    \n    rectangle_x_min = round(x_pos - (size/2))\n    rectangle_x_max = round(x_pos + (size/2))\n    rectangle_y_min = round(y_pos - (size/2))\n    rectangle_y_max = round(y_pos + (size/2))\n    \n    \n    #print(f\"r_x_min: {rectangle_x_min}, r_x_max: {rectangle_x_max}, r_y_min: {rectangle_y_min}, r_y_max: {rectangle_y_max}, list_bgr: {colour_bgr}\")\n    \n    \n    image[rectangle_y_min:rectangle_y_max, rectangle_x_min:rectangle_x_max] = colour_bgr\n   \n    context[\"image\"] = image\n","form":[{"id":1777374514832,"type":"number","label":"Position","formKey":"POS_form","min":"0","max":"","defaultValue":0,"visibility":""},{"id":1777374607765,"type":"number","label":"MAX","formKey":"MAX_form","min":"0","max":"","defaultValue":"2","visibility":""},{"id":1777374959554,"type":"number","label":"Colour {0:r, 1:g, 2:b, 3:c, 4:m, 5:y, 6:k, 7:w}","formKey":"colour_form","min":"0","max":"7","defaultValue":"1","visibility":""},{"id":1777375070374,"type":"number","label":"Size [pixels]","formKey":"size_form","min":"0","max":"","defaultValue":"20","visibility":""},{"id":1777375120175,"type":"number","label":"Offset","formKey":"offset_form","min":"0","max":"","defaultValue":"50","visibility":""}],"formValues":{"POS_form":"0","MAX_form":"2","colour_form":"4","size_form":"20","offset_form":"40"},"showImagePreview":true,"editDate":1777376596098,"isActive":true},"version":"3.19.3"}