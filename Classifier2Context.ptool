{"type":"CODE","module":{"label":"Classifier2Context","id":114,"note":"Uloží výsledek klasifikátoru do globalData -> classifier_result\n(název proměnné je možné změnit ve formuláři)","gpuSettings":[],"softDeletedDate":null,"type":"CODE","sourceCode":"from pekat_communication import PEKAT\n\ndef main(context, form):\n    result = rectanglesGetter(context, \"CLASSIFIER\")\n    \n    variable_name = form[\"variable_name\"]\n    context[\"globalData\"][variable_name] = result\n    \n    print(result)\n    \n    \ndef rectanglesGetter(context, source: str, index: int = 0) -> str:\n    detectedRectangles = context[\"detectedRectangles\"]  # Ziska z aktualniho snimku vsechny detekovane objekty (do budoucna by slo opet nejak osetrit)\n    \n    itemClassNames = []     # vytvoří list plný slovníků \"classNames\", když takový nenajde, vrátí []\n    for rect in detectedRectangles:\n        sourceType = rect.get(\"source\", {}).get(\"type\", []) # Zjistí z jakého modulu daný detekovaný \"rectangle\" pochází\n        \n        if sourceType == source:    # Pokud daný detekovaný \"rectangle\" pochází z source (\"DETECTOR\" nebo \"CLASSIFIER\"), pokračuje s ním dál a připojí ho k listu itemClassNames, pokud nepochází z \"DETECTORu\", zahodí ho\n            itemClassNames.append(rect.get(\"classNames\", []))  \n        else:\n            continue\n        \n    result = itemClassNames[0][index]['label']\n    return result","form":[{"id":1784017967140,"type":"text","label":"Variable name","formKey":"variable_name","defaultValue":"classifier_result","visibility":""}],"formValues":{},"showImagePreview":true,"editDate":1784018278798,"isActive":true},"version":"4.0.1"}